---
// EAGLE-2's dynamic draft tree (S02), toy numbers. Each node has the drafter's confidence c for its token and a
// value V = product of c along the path from the root, an estimate of the chance the target accepts the whole
// path. Expansion: at each depth, only the top-k nodes by V (k = 2 here) are expanded. Rerank: after drafting,
// keep the m nodes (m = 6 here) with the highest V over the whole tree; V never rises along a path, so they
// form a connected tree. The target verifies that tree in one pass.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;

type Node = { id: string; tok: string; d: number; y: number; p?: string; c?: number };
const raw: Node[] = [
	{ id: 'r', tok: 'How', d: 0, y: 180 },
	{ id: 'can', tok: 'can', d: 1, y: 90, p: 'r', c: 0.6 },
	{ id: 'do1', tok: 'do', d: 1, y: 250, p: 'r', c: 0.3 },
	{ id: 'is', tok: 'is', d: 1, y: 330, p: 'r', c: 0.05 },
	{ id: 'I', tok: 'I', d: 2, y: 60, p: 'can', c: 0.7 },
	{ id: 'we', tok: 'we', d: 2, y: 140, p: 'can', c: 0.2 },
	{ id: 'you', tok: 'you', d: 2, y: 225, p: 'do1', c: 0.6 },
	{ id: 'it', tok: 'it', d: 2, y: 300, p: 'do1', c: 0.3 },
	{ id: 'do3', tok: 'do', d: 3, y: 30, p: 'I', c: 0.8 },
	{ id: 'help', tok: 'help', d: 3, y: 95, p: 'I', c: 0.1 },
	{ id: 'know', tok: 'know', d: 3, y: 195, p: 'you', c: 0.5 },
	{ id: 'think', tok: 'think', d: 3, y: 260, p: 'you', c: 0.3 },
];
const byId = Object.fromEntries(raw.map((n) => [n.id, n]));
const V: Record<string, number> = {};
for (const n of raw) V[n.id] = n.p ? V[n.p] * (n.c ?? 1) : 1;
const X = [50, 210, 370, 530];
const R = 19;
// Expanded at the next depth: top 2 by V at each depth (depth 0: the root).
const expanded = new Set(['r', 'can', 'do1', 'I', 'you']);
// Kept after rerank: top 6 by V among drafted nodes.
const kept = new Set(
	raw
		.filter((n) => n.p)
		.sort((a, b) => V[b.id] - V[a.id])
		.slice(0, 6)
		.map((n) => n.id),
);
const accepted = new Set(['can', 'I', 'do3']);
const fmt = (v: number) => v.toFixed(2).replace(/^0/, '');
---

<figure class="et" data-et>
	<div class="et-controls">
		<button class="btn primary" type="button" data-act="play">Play</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Back">‹</button>
		<button class="btn icon" type="button" data-act="next" aria-label="Forward">›</button>
		<span class="et-step" data-stepno></span>
	</div>

	<svg viewBox="0 0 640 370" role="img" aria-label="EAGLE-2 draft tree: grow the nodes with the highest path value, then keep the best nodes over the whole tree for verification.">
		{raw.filter((n) => n.p).map((n) => {
			const p = byId[n.p!];
			const x1 = X[p.d] + R;
			const x2 = X[n.d] - R;
			return (
				<g class="edge" data-d={n.d} data-id={n.id}>
					<line x1={x1} y1={p.y} x2={x2} y2={n.y} />
					<text x={(x1 + x2) / 2} y={(p.y + n.y) / 2 - 5} text-anchor="middle" class="c">c {fmt(n.c!)}</text>
				</g>
			);
		})}
		{raw.map((n) => (
			<g
				class="node"
				data-d={n.d}
				data-id={n.id}
				data-exp={expanded.has(n.id) ? '1' : '0'}
				data-kept={!n.p || kept.has(n.id) ? '1' : '0'}
				data-acc={!n.p || accepted.has(n.id) ? '1' : '0'}
			>
				<circle cx={X[n.d]} cy={n.y} r={R} />
				<text x={X[n.d]} y={n.y + 4} text-anchor="middle" class="tok">{n.tok}</text>
				{n.p && <text x={X[n.d] + R + 5} y={n.y + 4} class="v">V {fmt(V[n.id])}</text>}
			</g>
		))}
		{[1, 2, 3].map((d) => <text x={X[d]} y="362" text-anchor="middle" class="depth">depth {d}</text>)}
	</svg>

	<p class="et-note" data-note aria-live="polite"></p>
	<p class="et-legend" aria-hidden="true">
		<span><i class="sw exp"></i>expanded: its children were drafted</span>
		<span><i class="sw kept"></i>kept for verification</span>
		<span><i class="sw drop"></i>dropped</span>
		<span><i class="sw acc"></i>accepted by the target</span>
	</p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	const NOTES = [
		'Depth 1. One drafter pass proposes candidates for the next token, each with its confidence c. A node\'s value V is the product of c along its path: an estimate of the chance that the target accepts everything up to it.',
		'Depth 2. Expand only the top 2 nodes by V: "can" (.60) and "do" (.30). "is" (.05) is never expanded. One drafter pass handles both expanded nodes together.',
		'Depth 3. Again expand the top 2 by V across the whole depth: "I" (.42) and "you" (.18). "we" and "it" stop growing. The tree grows where the drafter is confident.',
		'Rerank. Keep the 6 nodes with the highest V in the whole tree, at any depth. V never rises along a path, so a kept node\'s parent is always kept: they form a tree. "know" (.09) was drafted but is dropped; "we" (.12) was never expanded but is kept.',
		'Verify. One target pass checks all 6 kept nodes at once, with a tree attention mask (S05). The longest accepted path is How → can → I → do, and the target adds its own next token.',
	];
	const LAST = NOTES.length - 1;

	document.querySelectorAll<HTMLElement>('[data-et]').forEach((fig) => {
		const $ = (s: string) => fig.querySelector<HTMLElement>(s)!;
		const note = $('[data-note]');
		const stepno = $('[data-stepno]');
		const playBtn = $('[data-act="play"]') as HTMLButtonElement;
		const nodes = [...fig.querySelectorAll<SVGGElement>('.node')];
		const edges = [...fig.querySelectorAll<SVGGElement>('.edge')];
		let step = 0;
		let timer = 0;

		function render() {
			const depthShown = Math.min(step + 1, 3);
			const rerank = step >= 3;
			const verify = step >= 4;
			for (const g of nodes) {
				const d = +g.dataset.d!;
				g.classList.toggle('hide', d > depthShown);
				// a node shows as expanded once its children are visible
				g.classList.toggle('exp', g.dataset.exp === '1' && d < depthShown);
				g.classList.toggle('drop', rerank && g.dataset.kept === '0');
				g.classList.toggle('kept', rerank && g.dataset.kept === '1');
				g.classList.toggle('acc', verify && g.dataset.acc === '1');
			}
			for (const g of edges) {
				const d = +g.dataset.d!;
				const n = nodes.find((x) => x.dataset.id === g.dataset.id)!;
				g.classList.toggle('hide', d > depthShown);
				g.classList.toggle('drop', rerank && n.dataset.kept === '0');
				g.classList.toggle('acc', verify && n.dataset.acc === '1');
			}
			note.textContent = NOTES[step];
			stepno.textContent = `step ${step + 1} / ${NOTES.length}`;
			playBtn.textContent = timer ? 'Pause' : step === LAST ? 'Replay' : 'Play';
		}
		function stop() {
			window.clearInterval(timer);
			timer = 0;
		}
		function go(s: number) {
			step = Math.max(0, Math.min(LAST, s));
			render();
		}
		playBtn.addEventListener('click', () => {
			if (timer) {
				stop();
				render();
				return;
			}
			if (step === LAST) step = 0;
			timer = window.setInterval(() => {
				if (step >= LAST) {
					stop();
					render();
					return;
				}
				go(step + 1);
			}, 3400);
			render();
		});
		$('[data-act="prev"]').addEventListener('click', () => {
			stop();
			go(step - 1);
		});
		$('[data-act="next"]').addEventListener('click', () => {
			stop();
			go(step + 1);
		});
		render();
	});
</script>

<style>
	.et {
		--c-exp: #2f6fb3;
		--c-acc: #2f7d4f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .et {
		--c-exp: #4f8fd6;
		--c-acc: #4fb07a;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .et {
			--c-exp: #4f8fd6;
			--c-acc: #4fb07a;
		}
	}
	.et-controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.et-step {
		margin-left: auto;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 0.8rem;
		font-family: var(--mono);
	}
	.edge line {
		stroke: var(--fg);
		stroke-opacity: 0.45;
		stroke-width: 1.5;
	}
	.c {
		font-size: 10px;
		fill: var(--muted);
	}
	.node circle {
		fill: var(--surface);
		stroke: var(--fg);
		stroke-opacity: 0.5;
		stroke-width: 1.5;
	}
	.tok {
		font-size: 12px;
		fill: var(--fg);
	}
	.v {
		font-size: 10px;
		fill: var(--c-exp);
	}
	.depth {
		font-size: 10px;
		fill: var(--faint);
	}
	.node,
	.edge {
		transition: opacity 0.35s;
	}
	.node circle,
	.edge line {
		transition: stroke 0.3s, fill 0.3s, stroke-width 0.3s;
	}
	.hide {
		opacity: 0;
	}
	.node.exp circle {
		stroke: var(--c-exp);
		stroke-opacity: 1;
		stroke-width: 2.5;
		fill: color-mix(in srgb, var(--c-exp) 12%, var(--surface));
	}
	.node.kept circle {
		stroke: var(--c-exp);
		stroke-opacity: 1;
		fill: color-mix(in srgb, var(--c-exp) 12%, var(--surface));
	}
	.drop {
		opacity: 0.2;
	}
	.node.drop circle {
		stroke-dasharray: 3 3;
	}
	.node.acc circle {
		stroke: var(--c-acc);
		stroke-width: 2.5;
		fill: color-mix(in srgb, var(--c-acc) 18%, var(--surface));
	}
	.edge.acc line {
		stroke: var(--c-acc);
		stroke-opacity: 1;
		stroke-width: 3;
	}
	.et-note {
		min-height: 4.6em;
		margin: 0.9rem 0 0;
		padding: 0.7rem 0.9rem;
		border-left: 3px solid var(--accent);
		background: var(--code-bg);
		border-radius: 0 6px 6px 0;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.et-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 1rem 0 0;
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
	}
	.et-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		display: inline-block;
		border-radius: 50%;
		border: 1.5px solid var(--fg);
	}
	.sw.exp {
		border: 2.5px solid var(--c-exp);
	}
	.sw.kept {
		border-color: var(--c-exp);
		background: color-mix(in srgb, var(--c-exp) 12%, var(--surface));
	}
	.sw.drop {
		border-style: dashed;
		opacity: 0.4;
	}
	.sw.acc {
		border: 2.5px solid var(--c-acc);
		background: color-mix(in srgb, var(--c-acc) 18%, var(--surface));
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.et {
			padding: 1rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.node,
		.edge,
		.node circle,
		.edge line {
			transition: none;
		}
	}
</style>
