---
// d3LLM pseudo-trajectory distillation (§3.1, Figure 2), on the paper's own example.
// Stages: the teacher decodes the window one token per step (its tokens may differ from the ground truth);
// only the order is kept; the mask ratio t masks the last ceil(k·t) positions in that order; the noisy input
// is the ground truth with those masks, a clean prefix and a masked suffix; the student is trained with
// cross-entropy against the ground truth at every mask. "Random" shows ordinary random masking instead.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const gt = ['I', 'think', 'Diff', 'usion', 'L', 'LM', 'is', 'good'];
const win = [2, 3, 4]; // the current block (window)
const teacherOrder = [3, 2, 4]; // usion 1st, Diff 2nd, L 3rd (Figure 2)
const teacherTok: Record<number, string> = { 2: 'Diff', 3: 'usion', 4: 'LM' }; // the teacher's own guess at position 4 is wrong
---

<figure class="dt" data-dt data-config={JSON.stringify({ gt, win, teacherOrder, teacherTok })}>
	<div class="dt-controls">
		<button class="btn primary" type="button" data-act="play">Play</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Previous stage">‹</button>
		<button class="btn icon" type="button" data-act="next" aria-label="Next stage">›</button>
		<label class="dt-t">mask ratio <i>t</i> = <b data-v="t"></b><input type="range" min="0" max="1" step="0.01" value="0.66" data-in="t" /></label>
		<div class="dt-seg" role="radiogroup" aria-label="Masking order">
			<button type="button" role="radio" aria-checked="true" data-order="teacher">teacher's order</button>
			<button type="button" role="radio" aria-checked="false" data-order="random">random</button>
		</div>
	</div>

	<p class="dt-prompt"><span class="k">Prompt</span><i>What do you think of dLLM?</i></p>
	<div class="dt-grid" data-grid></div>
	<ol class="dt-stages" data-stages></ol>
	<p class="dt-note" data-note aria-live="polite"></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type Cfg = { gt: string[]; win: number[]; teacherOrder: number[]; teacherTok: Record<number, string> };
	const STAGES = ['Teacher, step 1', 'Teacher, step 2', 'Teacher, step 3', 'Keep only the order', 'Mask by t', 'Train the student'];
	document.querySelectorAll<HTMLElement>('[data-dt]').forEach((fig) => {
		const { gt, win, teacherOrder, teacherTok } = JSON.parse(fig.dataset.config!) as Cfg;
		const grid = fig.querySelector<HTMLElement>('[data-grid]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const stagesEl = fig.querySelector<HTMLElement>('[data-stages]')!;
		const tIn = fig.querySelector<HTMLInputElement>('[data-in="t"]')!;
		const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		const k = win.length;
		let stage = 0; // 0 = nothing yet, 1..6 as STAGES
		let order: 'teacher' | 'random' = 'teacher';
		let randomOrder = [...win];
		let timer: number | undefined;
		const rank = (pos: number, o: number[]) => o.indexOf(pos) + 1; // 1-based

		function shuffle() {
			randomOrder = [...win];
			for (let i = randomOrder.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[randomOrder[i], randomOrder[j]] = [randomOrder[j], randomOrder[i]];
			}
		}

		function render() {
			const t = Number(tIn.value);
			fig.querySelector('[data-v="t"]')!.textContent = t.toFixed(2);
			const nMask = Math.ceil(k * t);
			const nKeep = k - nMask;
			const o = order === 'teacher' ? teacherOrder : randomOrder;
			const visibleInWin = (pos: number) => rank(pos, o) <= nKeep;
			const ord = (n: number) => ['1st', '2nd', '3rd'][n - 1];

			const cell = (pos: number, row: string) => {
				const inWin = win.includes(pos);
				if (row === 'gt') return `<span class="tok ${inWin ? 'win' : 'out'}">${gt[pos]}</span>`;
				if (row === 'teacher') {
					if (!inWin) return '<span class="tok blank"></span>';
					const r = rank(pos, teacherOrder);
					const decoded = stage >= 1 && r <= Math.min(stage, 3);
					if (stage >= 4) return `<span class="tok badge ${order === 'random' ? 'dim' : ''}">${ord(r)}</span>`;
					if (!decoded) return '<span class="tok mask">[M]</span>';
					const fresh = r === stage;
					const wrong = teacherTok[pos] !== gt[pos];
					return `<span class="tok teach ${fresh ? 'fresh' : ''} ${wrong ? 'wrong' : ''}">${teacherTok[pos]}<sup>${ord(r)}</sup></span>`;
				}
				if (row === 'noisy') {
					if (stage < 5) return '<span class="tok blank"></span>';
					if (pos < win[0]) return `<span class="tok clean">${gt[pos]}</span>`;
					if (pos > win[k - 1]) return '<span class="tok mask">[M]</span>';
					return visibleInWin(pos) ? `<span class="tok clean win">${gt[pos]}</span>` : '<span class="tok mask win">[M]</span>';
				}
				// student
				if (stage < 6) return '<span class="tok blank"></span>';
				const masked = pos > win[k - 1] || (inWin && !visibleInWin(pos));
				return masked ? `<span class="tok target ${inWin ? 'win' : ''}">→ ${gt[pos]}</span>` : '<span class="tok blank"></span>';
			};
			const row = (label: string, id: string, sub = '') =>
				`<span class="lab">${label}${sub ? `<small>${sub}</small>` : ''}</span>` + gt.map((_, p) => cell(p, id)).join('');
			const braceRow =
				'<span></span>' +
				gt
					.map((_, p) => (p === win[0] ? `<span class="brace" style="grid-column: span ${k}">current block (window), k = ${k}</span>` : win.includes(p) ? '' : '<span></span>'))
					.join('');
			grid.innerHTML =
				row('Ground truth', 'gt') +
				braceRow +
				row("Teacher's pseudo-trajectory", 'teacher', 'one token per step') +
				row('Noisy input', 'noisy', `t = ${t.toFixed(2)}: mask ⌈k·t⌉ = ${nMask}`) +
				row('Student is trained on', 'student', 'cross-entropy vs. ground truth');

			stagesEl.innerHTML = STAGES.map((s, i) => `<li class="${i + 1 === stage ? 'on' : i + 1 < stage ? 'done' : ''}">${s}</li>`).join('');

			const msgs: Record<number, string> = {
				0: 'The teacher dLLM decodes the response to this prompt itself, one token per step. Press Play or ›.',
				1: 'Step 1: the teacher is most confident about "usion", so that position is filled first.',
				2: 'Step 2: "Diff" next.',
				3: 'Step 3: the last position. The teacher writes "LM", not the ground-truth "L": its answer can be wrong. That is why the trajectory is only "pseudo".',
				4:
					order === 'teacher'
						? "Throw the teacher's tokens away and keep only the order: usion 1st, Diff 2nd, L 3rd."
						: 'Random masking ignores the teacher: any position may stay visible, regardless of how hard it is.',
				5:
					nKeep === 0
						? `t = ${t.toFixed(2)} masks the whole window.`
						: `With t = ${t.toFixed(2)}, ${nMask} of ${k} window positions are masked: the ones the teacher filled last. The ${nKeep === 1 ? 'one' : nKeep} filled first ${nKeep === 1 ? 'stays' : 'stay'} visible, with the ground-truth token. Before the window: clean. After it: masked.`,
				6:
					order === 'teacher'
						? 'The student predicts every mask from this input, scored against the ground truth. It always sees the easy positions and is asked for the hard ones, as at an early step of decoding. So it learns which tokens can be committed first.'
						: 'With random masking the student may see a hard token and be asked for an easy one. It learns to fill blanks, but nothing about which ones are safe to commit early.',
			};
			note.textContent = msgs[stage];
			playBtn.textContent = timer ? 'Pause' : stage >= 6 ? 'Replay' : 'Play';
		}

		function stop() {
			if (timer) clearInterval(timer);
			timer = undefined;
			render();
		}
		playBtn.addEventListener('click', () => {
			if (timer) return stop();
			if (stage >= 6) stage = 0;
			timer = window.setInterval(() => {
				stage++;
				if (stage >= 6) stop();
				else render();
			}, 1400);
			render();
		});
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => {
			if (timer) clearInterval(timer);
			timer = undefined;
			stage = Math.max(0, stage - 1);
			render();
		});
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			if (timer) clearInterval(timer);
			timer = undefined;
			stage = Math.min(6, stage + 1);
			render();
		});
		tIn.addEventListener('input', () => {
			if (stage < 5) stage = 5;
			render();
		});
		fig.querySelectorAll<HTMLButtonElement>('[data-order]').forEach((b) =>
			b.addEventListener('click', () => {
				order = b.dataset.order as 'teacher' | 'random';
				if (order === 'random') shuffle();
				fig.querySelectorAll('[data-order]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
				if (stage < 4) stage = 4;
				render();
			}),
		);
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.dt {
		--c-win: #2f6fb3;
		--c-teach: #2f6fb3;
		--c-stu: #c2410c;
		--c-bad: #b7791f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .dt {
		--c-win: #4f8fd6;
		--c-teach: #4f8fd6;
		--c-stu: #e06a2c;
		--c-bad: #e0b04f;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .dt {
			--c-win: #4f8fd6;
			--c-teach: #4f8fd6;
			--c-stu: #e06a2c;
			--c-bad: #e0b04f;
		}
	}
	.dt:not(.ready) {
		display: none;
	}
	.dt-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.8rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px dashed var(--line);
	}
	.dt-t {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font: 0.74rem var(--mono);
		color: var(--muted);
	}
	.dt-t b {
		color: var(--fg);
		min-width: 2.2em;
	}
	.dt-t input {
		width: 8rem;
		accent-color: var(--c-win);
	}
	.dt-seg {
		display: inline-flex;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 2px;
	}
	.dt-seg button {
		border: 0;
		background: none;
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		font: 0.72rem var(--mono);
		color: var(--muted);
		cursor: pointer;
	}
	.dt-seg button[aria-checked='true'] {
		background: var(--code-bg);
		color: var(--fg);
		font-weight: 600;
	}
	.dt-prompt {
		display: flex;
		gap: 0.8rem;
		margin: 0.9rem 0 0.4rem;
		font-size: 0.95rem;
	}
	.dt .k {
		font: 0.74rem var(--mono);
		color: var(--muted);
		min-width: 9.5rem;
	}
	.dt-grid {
		display: grid;
		grid-template-columns: 9.5rem repeat(8, minmax(0, 1fr));
		gap: 0.45rem 0.35rem;
		align-items: center;
	}
	.dt-grid :global(.lab) {
		display: grid;
		font: 600 0.72rem var(--mono);
		line-height: 1.25;
	}
	.dt-grid :global(.lab small) {
		font-weight: 400;
		font-size: 0.64rem;
		color: var(--muted);
	}
	.dt-grid :global(.brace) {
		margin-top: -0.3rem;
		padding-top: 0.25rem;
		border-top: 2px solid var(--c-win);
		border-radius: 6px 6px 0 0;
		text-align: center;
		font: 0.66rem var(--mono);
		color: var(--c-win);
	}
	.dt-grid :global(.tok) {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 2.2rem;
		padding: 0 0.2rem;
		border-radius: 5px;
		font-size: 0.9rem;
		transition:
			background 0.3s,
			border-color 0.3s,
			opacity 0.3s;
	}
	.dt-grid :global(.tok.out) {
		border: 1.5px dashed var(--line);
	}
	.dt-grid :global(.tok.win) {
		border: 1.5px solid var(--c-win);
	}
	.dt-grid :global(.tok.blank) {
		border: 1px dotted transparent;
	}
	.dt-grid :global(.tok.mask) {
		border: 1.5px dashed var(--muted);
		font: 0.72rem var(--mono);
		color: var(--muted);
		background: var(--code-bg);
	}
	.dt-grid :global(.tok.teach) {
		border: 1.5px solid var(--c-teach);
		background: color-mix(in srgb, var(--c-teach) 12%, var(--surface));
	}
	.dt-grid :global(.tok.teach.fresh) {
		background: color-mix(in srgb, var(--c-teach) 30%, var(--surface));
	}
	.dt-grid :global(.tok.teach.wrong) {
		border-color: var(--c-bad);
		text-decoration: underline wavy var(--c-bad);
	}
	.dt-grid :global(.tok sup) {
		position: absolute;
		top: 2px;
		right: 4px;
		font: 0.58rem var(--mono);
		color: var(--muted);
	}
	.dt-grid :global(.tok.badge) {
		border: 1.5px solid var(--c-teach);
		border-radius: 999px;
		font: 600 0.78rem var(--mono);
		color: var(--c-teach);
		background: color-mix(in srgb, var(--c-teach) 10%, var(--surface));
	}
	.dt-grid :global(.tok.badge.dim) {
		opacity: 0.35;
	}
	.dt-grid :global(.tok.clean) {
		border: 1.5px solid var(--line);
	}
	.dt-grid :global(.tok.clean.win) {
		border-color: var(--c-win);
	}
	.dt-grid :global(.tok.mask.win) {
		border-color: var(--c-win);
	}
	.dt-grid :global(.tok.target) {
		border: 1.5px solid var(--c-stu);
		font-size: 0.78rem;
		white-space: nowrap;
		color: var(--c-stu);
		background: color-mix(in srgb, var(--c-stu) 8%, var(--surface));
	}
	.dt-grid :global(.tok.target.win) {
		background: color-mix(in srgb, var(--c-stu) 18%, var(--surface));
		font-weight: 600;
	}
	.dt-stages {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.9rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: st;
		font: 0.68rem var(--mono);
		color: var(--muted);
	}
	.dt-stages :global(li) {
		counter-increment: st;
	}
	.dt-stages :global(li)::before {
		content: counter(st) '. ';
	}
	.dt-stages :global(li.done) {
		color: var(--fg);
	}
	.dt-stages :global(li.on) {
		color: var(--c-stu);
		font-weight: 600;
	}
	.dt-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.dt {
			padding: 1rem;
		}
		.dt-grid {
			grid-template-columns: 5.5rem repeat(8, minmax(0, 1fr));
			gap: 0.35rem 0.15rem;
		}
		.dt-grid :global(.lab small) {
			display: none;
		}
		.dt-grid :global(.tok) {
			font-size: 0.7rem;
		}
	}
</style>
