---
// Self-speculative decoding (Nemotron-Labs-Sigma §6, NLD) against plain AR decoding and classic speculative
// decoding with a separate drafter. Same 13-token answer in all three lanes. The clock runs in toy cost units:
// one AR step of the big model = 1. Classic: a small drafter proposes 4 tokens left to right (0.25 each), the
// big model verifies them in one pass (1). Self-spec: the same model's diffusion head drafts a whole block of 8
// from noise in one pass, and its AR head verifies the block in one pass; each pass covers a whole block, so
// each costs a bit more than an AR step (1.25 here; the paper measures a round at 3.0-3.5 AR steps for blocks
// of 32). Verification keeps the longest prefix matching the verifier's greedy tokens, plus one token of its
// own, so every lane outputs the same text.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
---

<figure class="sd" data-sd>
	<div class="sd-controls">
		<button class="btn primary" type="button" data-act="play">Play</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Back">‹</button>
		<button class="btn icon" type="button" data-act="next" aria-label="Forward">›</button>
		<span class="sd-clock" data-clock></span>
	</div>
	<div class="sd-lanes" data-lanes></div>
	<p class="sd-legend" aria-hidden="true">
		<span><i class="sw ok"></i>committed</span>
		<span><i class="sw dr"></i>draft, not yet checked</span>
		<span><i class="sw acc"></i>draft accepted</span>
		<span><i class="sw bad"></i>draft rejected</span>
		<span><i class="sw bon"></i>verifier's own token</span>
	</p>
	<p class="sd-note" data-note aria-live="polite"></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	const ANSWER = ['The', 'answer', 'is', '5', ',', 'so', 'we', 'add', '3', 'to', 'get', '8', '.'];
	type Ev =
		| { kind: 'ar'; dur: number }
		| { kind: 'draft1'; dur: number; tok: string } // one token from the small drafter
		| { kind: 'draftAll'; dur: number; toks: string[] } // a whole block from the diffusion head
		| { kind: 'verify'; dur: number };
	type Lane = { id: string; name: string; who: string; caches: string; events: Ev[] };

	// Drafts. A token that differs from ANSWER at its position is a wrong guess.
	const classicDrafts = [
		['The', 'answer', 'is', '5'], // all right: the verifier adds ","
		['so', 'we', 'add', '2'], // 4th wrong: the verifier writes "3"
		['to', 'get', '8', '.'],
	];
	const selfDrafts = [
		['The', 'answer', 'is', '5', ',', 'so', 'the', 'add'], // 7th wrong: verifier writes "we"
		['add', '3', 'to', 'get', '8', '.', 'eos', 'eos'],
	];
	const lanes: Lane[] = [
		{ id: 'ar', name: 'AR decoding', who: 'big model, one token per step', caches: '1 KV cache', events: ANSWER.map(() => ({ kind: 'ar', dur: 1 })) },
		{
			id: 'classic',
			name: 'Speculative decoding',
			who: 'separate small drafter, 4 tokens left to right',
			caches: '2 KV caches (big model + drafter)',
			events: [],
		},
		{
			id: 'self',
			name: 'Self-speculative (Sigma, NLD)',
			who: 'same model: diffusion head drafts a block in one call, AR head verifies',
			caches: '1 KV cache, shared by both heads',
			events: [],
		},
	];
	// Build the round structure; rounds stop once the answer is complete (simulated below).
	for (const d of classicDrafts) {
		d.forEach((tok) => lanes[1].events.push({ kind: 'draft1', dur: 0.25, tok }));
		lanes[1].events.push({ kind: 'verify', dur: 1 });
	}
	for (const d of selfDrafts) {
		lanes[2].events.push({ kind: 'draftAll', dur: 1.25, toks: d });
		lanes[2].events.push({ kind: 'verify', dur: 1.25 });
	}

	type Slot = { tok: string; st: 'dr' | 'acc' | 'bad' | 'gone' };
	type State = { committed: string[]; draft: Slot[]; bonus: number; running: string; bigF: number; smallF: number; done: boolean; doneAt: number };

	// Replay a lane up to clock c. An event "runs" during [start, start + dur) and its effect applies at its end.
	function stateAt(lane: Lane, c: number): State {
		const s: State = { committed: [], draft: [], bonus: -1, running: '', bigF: 0, smallF: 0, done: false, doneAt: 0 };
		let t = 0;
		for (const ev of lane.events) {
			if (s.committed.length >= ANSWER.length) break;
			const end = t + ev.dur;
			if (c < end - 1e-9) {
				s.running = c >= t ? ev.kind : '';
				break;
			}
			// apply
			if (ev.kind === 'ar') {
				s.bigF++;
				s.committed.push(ANSWER[s.committed.length]);
				s.bonus = -1;
				s.draft = [];
			} else if (ev.kind === 'draft1' || ev.kind === 'draftAll') {
				if (s.draft.length && s.draft.every((d) => d.st !== 'dr')) s.draft = [];
				if (ev.kind === 'draft1') {
					s.smallF++;
					s.draft.push({ tok: ev.tok, st: 'dr' });
				} else {
					s.bigF++;
					s.draft = ev.toks.map((tok) => ({ tok, st: 'dr' as const }));
				}
				s.bonus = -1;
			} else {
				s.bigF++;
				let ok = true;
				for (const d of s.draft) {
					const want = ANSWER[s.committed.length];
					if (want === undefined) d.st = 'gone';
					else if (ok && d.tok === want) {
						d.st = 'acc';
						s.committed.push(d.tok);
					} else if (ok) {
						ok = false;
						d.st = 'bad';
					} else d.st = 'gone';
				}
				if (s.committed.length < ANSWER.length) {
					s.committed.push(ANSWER[s.committed.length]); // the verifier's own token
					s.bonus = s.committed.length - 1;
				} else s.bonus = -1;
			}
			t = end;
			if (s.committed.length >= ANSWER.length) {
				s.done = true;
				s.doneAt = t;
			}
		}
		return s;
	}
	function finishTime(lane: Lane) {
		let c = 0;
		while (!stateAt(lane, c).done && c < 50) c += 0.25;
		return c;
	}

	document.querySelectorAll<HTMLElement>('[data-sd]').forEach((fig) => {
		const lanesEl = fig.querySelector<HTMLElement>('[data-lanes]')!;
		const clockEl = fig.querySelector<HTMLElement>('[data-clock]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		const ends = lanes.map(finishTime);
		const MAX = Math.max(...ends);
		let clock = 0;
		let timer: number | undefined;

		function laneHTML(lane: Lane, i: number) {
			const s = stateAt(lane, clock);
			const cells = ANSWER.map((_, p) => {
				if (p < s.committed.length) return `<span class="c ${p === s.bonus ? 'bon' : 'ok'}">${s.committed[p]}</span>`;
				return '<span class="c empty"></span>';
			}).join('');
			const drafting = s.running === 'draft1' || s.running === 'draftAll';
			const noise = s.running === 'draftAll' ? Array.from({ length: 8 }, () => '<span class="d noise"></span>').join('') : '';
			const draftRow = s.running === 'draftAll' ? noise : s.draft.map((d) => `<span class="d ${d.st}">${d.tok}</span>`).join('') + (s.running === 'draft1' ? '<span class="d noise"></span>' : '');
			const act = s.done
				? `done at ${ends[i].toFixed(2)}`
				: s.running === 'ar'
					? 'big model: 1 step'
					: s.running === 'draft1'
						? 'small drafter: next guess'
						: s.running === 'draftAll'
							? 'diffusion head: whole block from noise, one call'
							: s.running === 'verify'
								? lane.id === 'self'
									? 'AR head: check the block, one causal pass'
									: 'big model: check the drafts, one pass'
								: '';
			return `<div class="lane ${s.done ? 'fin' : ''}">
				<div class="lh"><b>${lane.name}</b><small>${lane.who}</small></div>
				<div class="row">${cells}</div>
				${lane.id === 'ar' ? '' : `<div class="drow ${drafting ? 'busy' : ''}"><span class="k">draft</span>${draftRow || '<span class="d none">—</span>'}</div>`}
				<div class="ls">
					<span class="act ${s.running ? 'on' : ''}">${act || '&nbsp;'}</span>
					<span>big-model passes <b>${s.bigF}</b></span>
					${lane.id === 'classic' ? `<span>drafter passes <b>${s.smallF}</b></span>` : ''}
					<span>${lane.caches}</span>
				</div>
			</div>`;
		}
		function render() {
			clockEl.textContent = `time ${clock.toFixed(2)} (1 = one AR step)`;
			lanesEl.innerHTML = lanes.map(laneHTML).join('');
			const sSelf = stateAt(lanes[2], clock);
			const sCl = stateAt(lanes[1], clock);
			note.textContent =
				clock === 0
					? 'All three produce the same 13 tokens: verification keeps only what the verifier would have chosen itself. Press Play.'
					: clock >= MAX
						? `Finished at ${ends.map((e) => e.toFixed(2)).join(', ')}. The classic drafter guesses a few tokens one after another; the diffusion head guesses a whole block at once, but each of its passes covers the whole block and costs more.`
						: sSelf.running === 'draftAll'
							? 'Self-spec draft: every position of the block starts as noise and is read out after a single denoiser call. No left-to-right order.'
							: sCl.running === 'draft1'
								? 'Classic draft: the small model writes one token per pass, left to right, like any AR model.'
								: sSelf.draft.some((d) => d.st === 'bad') && sSelf.running !== 'verify'
									? 'Self-spec: drafts after the first mismatch are thrown away, even if some were right; the verifier writes its own token in place of the first wrong one.'
									: '';
			playBtn.textContent = timer ? 'Pause' : clock >= MAX ? 'Replay' : 'Play';
		}
		function stop() {
			if (timer) clearInterval(timer);
			timer = undefined;
		}
		playBtn.addEventListener('click', () => {
			if (timer) {
				stop();
				return render();
			}
			if (clock >= MAX) clock = 0;
			timer = window.setInterval(() => {
				clock = Math.min(MAX, clock + 0.25);
				if (clock >= MAX) stop();
				render();
			}, 380);
			render();
		});
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => {
			stop();
			clock = Math.max(0, clock - 0.25);
			render();
		});
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			stop();
			clock = Math.min(MAX, clock + 0.25);
			render();
		});
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.sd {
		--c-ok: #2f6fb3;
		--c-dr: #b7791f;
		--c-bad: #c2410c;
		--c-bon: #2f7d4f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .sd {
		--c-ok: #4f8fd6;
		--c-dr: #e0b04f;
		--c-bad: #e06a2c;
		--c-bon: #4fb07a;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sd {
			--c-ok: #4f8fd6;
			--c-dr: #e0b04f;
			--c-bad: #e06a2c;
			--c-bon: #4fb07a;
		}
	}
	.sd:not(.ready) {
		display: none;
	}
	.sd-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.6rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px dashed var(--line);
	}
	.sd-clock {
		font: 0.74rem var(--mono);
		color: var(--muted);
	}
	.sd-lanes {
		display: grid;
		gap: 0.8rem;
		margin-top: 0.9rem;
	}
	.sd-lanes :global(.lane) {
		display: grid;
		gap: 0.35rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--line);
	}
	.sd-lanes :global(.lh) {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.6rem;
		align-items: baseline;
	}
	.sd-lanes :global(.lh b) {
		font: 600 0.8rem var(--mono);
	}
	.sd-lanes :global(.lh small) {
		font-size: 0.72rem;
		color: var(--muted);
	}
	.sd-lanes :global(.lane.fin .lh b)::after {
		content: ' ✓';
		color: var(--c-bon);
	}
	.sd-lanes :global(.row),
	.sd-lanes :global(.drow) {
		display: grid;
		grid-template-columns: repeat(13, minmax(0, 1fr));
		gap: 3px;
	}
	.sd-lanes :global(.drow) {
		grid-template-columns: 3rem repeat(8, minmax(0, 1fr));
		max-width: 75%;
	}
	.sd-lanes :global(.k) {
		font: 0.66rem var(--mono);
		color: var(--muted);
		align-self: center;
	}
	.sd-lanes :global(.c),
	.sd-lanes :global(.d) {
		display: grid;
		place-items: center;
		min-height: 1.7rem;
		padding: 0 2px;
		border-radius: 4px;
		font: 0.72rem var(--mono);
		white-space: nowrap;
		overflow: hidden;
	}
	.sd-lanes :global(.c.empty) {
		border: 1px dashed var(--line);
	}
	.sd-lanes :global(.c.ok) {
		background: color-mix(in srgb, var(--c-ok) 16%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--c-ok) 45%, var(--surface));
	}
	.sd-lanes :global(.c.bon),
	.sd-lanes :global(.sw.bon) {
		background: color-mix(in srgb, var(--c-bon) 22%, var(--surface));
		border: 1.5px solid var(--c-bon);
	}
	.sd-lanes :global(.d.dr),
	.sw.dr {
		background: color-mix(in srgb, var(--c-dr) 16%, var(--surface));
		border: 1.5px dashed var(--c-dr);
	}
	.sd-lanes :global(.d.acc),
	.sw.acc {
		background: color-mix(in srgb, var(--c-ok) 16%, var(--surface));
		border: 1.5px solid var(--c-ok);
	}
	.sd-lanes :global(.d.bad),
	.sw.bad {
		border: 1.5px solid var(--c-bad);
		color: var(--c-bad);
		text-decoration: line-through;
	}
	.sd-lanes :global(.d.gone) {
		border: 1px dotted var(--line);
		color: var(--faint);
		text-decoration: line-through;
	}
	.sd-lanes :global(.d.noise) {
		background: repeating-linear-gradient(45deg, var(--code-bg) 0 3px, color-mix(in srgb, var(--c-dr) 25%, var(--surface)) 3px 6px);
		border: 1px solid var(--line);
	}
	.sd-lanes :global(.d.none) {
		color: var(--faint);
	}
	.sd-lanes :global(.ls) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1rem;
		font: 0.68rem var(--mono);
		color: var(--muted);
	}
	.sd-lanes :global(.ls b) {
		color: var(--fg);
	}
	.sd-lanes :global(.act) {
		min-width: 17rem;
	}
	.sd-lanes :global(.act.on) {
		color: var(--c-dr);
		font-weight: 600;
	}
	.sd-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin: 0.6rem 0 0;
		font: 0.7rem var(--mono);
		color: var(--muted);
	}
	.sd-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 3px;
	}
	.sw.ok {
		background: color-mix(in srgb, var(--c-ok) 16%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--c-ok) 45%, var(--surface));
	}
	.sw.bon {
		background: color-mix(in srgb, var(--c-bon) 22%, var(--surface));
		border: 1.5px solid var(--c-bon);
	}
	.sd-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.sd {
			padding: 1rem;
		}
		.sd-lanes :global(.c),
		.sd-lanes :global(.d) {
			font-size: 0.55rem;
		}
		.sd-lanes :global(.drow) {
			max-width: 100%;
		}
	}
</style>
