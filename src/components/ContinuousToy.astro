---
// M12: continuous diffusion on a 2-d toy. Three tokens on the unit circle (cat, dog, car). One position starts
// from Gaussian noise and is denoised with DDIM over 8 steps, alpha_t = cos(pi t / 2), sigma_t = sin(pi t / 2).
// Toy "model": logits = context logits (what the transformer would conclude from "The ___ barked") plus Plaid's
// output prior (alpha_t / sigma_t^2) z·e_v. Probabilities -> e_hat = sum p_v e_v -> DDIM step. At t = 0 the
// argmax is the token. "No context" leaves only the prior, so the readout becomes "nearest embedding".
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
---

<figure class="ct" data-ct>
	<div class="ct-controls">
		<label class="ct-sel">context
			<select data-ctx>
				<option value="barked" selected>The ___ barked</option>
				<option value="meowed">The ___ meowed</option>
				<option value="honked">The ___ honked</option>
				<option value="none">no context</option>
			</select>
		</label>
		<button class="btn primary" type="button" data-act="play">Play</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Previous step">‹</button>
		<button class="btn icon" type="button" data-act="next" aria-label="Next step">›</button>
		<button class="btn" type="button" data-act="noise">New noise</button>
	</div>
	<div class="ct-body">
		<svg class="ct-svg" viewBox="0 0 360 360" role="img" aria-label="Token embeddings on the unit circle and the noisy point moving toward them" data-svg></svg>
		<div class="ct-side">
			<p class="ct-step" data-step></p>
			<div class="ct-bars" data-bars></div>
			<dl class="ct-vals" data-vals></dl>
		</div>
	</div>
	<p class="ct-legend" aria-hidden="true">
		<span><i class="sw tok"></i>token embedding e</span>
		<span><i class="sw z"></i>z, the noisy state</span>
		<span><i class="sw eh"></i>ê, the predicted average</span>
	</p>
	<p class="ct-note" data-note aria-live="polite"></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type V2 = [number, number];
	const tokens: { name: string; e: V2 }[] = [
		{ name: 'cat', e: [1, 0] },
		{ name: 'dog', e: [0.8, 0.6] },
		{ name: 'car', e: [-1, 0] },
	];
	// Logits the transformer would add from the context (toy values).
	const ctxLogits: Record<string, number[]> = {
		barked: [1.0, 2.5, 0],
		meowed: [2.5, 1.0, 0],
		honked: [0, 0.3, 2.5],
		none: [0, 0, 0],
	};
	const N = 8;
	const alpha = (t: number) => Math.cos((Math.PI * t) / 2);
	const sigma = (t: number) => Math.sin((Math.PI * t) / 2);
	const T_END = 0.03; // readout: prior weight at a tiny but non-zero noise level

	function probs(z: V2, t: number, ctx: number[]) {
		const s = sigma(Math.max(t, T_END));
		const w = alpha(t) / (s * s);
		const logits = tokens.map((tk, i) => ctx[i] + w * (z[0] * tk.e[0] + z[1] * tk.e[1]));
		const m = Math.max(...logits);
		const ex = logits.map((l) => Math.exp(l - m));
		const sum = ex.reduce((a, b) => a + b, 0);
		return { p: ex.map((x) => x / sum), w };
	}

	type Frame = { t: number; z: V2; p: number[]; w: number; ehat: V2 };
	function run(z1: V2, ctx: number[]): Frame[] {
		const frames: Frame[] = [];
		let z: V2 = z1;
		for (let k = 0; k <= N; k++) {
			const t = 1 - k / N;
			const { p, w } = probs(z, t, ctx);
			const ehat: V2 = [0, 1].map((d) => tokens.reduce((a, tk, i) => a + p[i] * tk.e[d], 0)) as V2;
			frames.push({ t, z, p, w, ehat });
			if (k === N) break;
			const s = 1 - (k + 1) / N;
			// DDIM: eps_hat = (z - alpha_t e_hat) / sigma_t; z_s = alpha_s e_hat + sigma_s eps_hat
			const eps: V2 = [0, 1].map((d) => (z[d] - alpha(t) * ehat[d]) / sigma(t)) as V2;
			z = [0, 1].map((d) => alpha(s) * ehat[d] + sigma(s) * eps[d]) as V2;
		}
		return frames;
	}

	document.querySelectorAll<HTMLElement>('[data-ct]').forEach((fig) => {
		const svg = fig.querySelector<SVGSVGElement>('[data-svg]')!;
		const bars = fig.querySelector<HTMLElement>('[data-bars]')!;
		const vals = fig.querySelector<HTMLElement>('[data-vals]')!;
		const stepEl = fig.querySelector<HTMLElement>('[data-step]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const ctxSel = fig.querySelector<HTMLSelectElement>('[data-ctx]')!;
		const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		let seed = 3;
		const rand = () => {
			seed = (seed * 16807) % 2147483647;
			return seed / 2147483647;
		};
		const gauss = (): number => {
			const u = Math.max(rand(), 1e-9);
			return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * rand());
		};
		let z1: V2 = [-0.35, -0.75];
		let frames = run(z1, ctxLogits[ctxSel.value]);
		let k = 0;
		let timer: number | undefined;

		const C = 180;
		const R = 95; // pixels per unit
		const px = (v: V2) => [C + v[0] * R, C - v[1] * R];

		function render() {
			const f = frames[k];
			const last = k === N;
			const [zx, zy] = px(f.z);
			const [ex, ey] = px(f.ehat);
			const path = frames
				.slice(0, k + 1)
				.map((fr) => px(fr.z).map((n) => n.toFixed(1)).join(','))
				.join(' ');
			const best = f.p.indexOf(Math.max(...f.p));
			svg.innerHTML = `
				<line class="ax" x1="10" y1="${C}" x2="350" y2="${C}"/><line class="ax" x1="${C}" y1="10" x2="${C}" y2="350"/>
				<circle class="unit" cx="${C}" cy="${C}" r="${R}"/>
				${tokens
					.map((tk, i) => {
						const [x, y] = px(tk.e);
						const lx = x + (tk.e[0] >= 0 ? 10 : -10);
						return `<circle class="tk ${last && i === best ? 'win' : ''}" cx="${x}" cy="${y}" r="${6 + 10 * f.p[i]}"/>
							<text class="tl" x="${lx}" y="${y - 10}" text-anchor="${tk.e[0] >= 0 ? 'start' : 'end'}">${tk.name}</text>`;
					})
					.join('')}
				<polyline class="path" points="${path}"/>
				${last ? '' : `<line class="arrow" x1="${zx}" y1="${zy}" x2="${ex}" y2="${ey}"/>`}
				<rect class="eh" x="${ex - 6}" y="${ey - 6}" width="12" height="12" transform="rotate(45 ${ex} ${ey})"/>
				<circle class="z" cx="${zx}" cy="${zy}" r="6.5"/>
				<text class="zl" x="${zx + 10}" y="${zy + 16}">z</text>`;
			bars.innerHTML = tokens
				.map(
					(tk, i) =>
						`<div class="bar"><span class="bn">${tk.name}</span><span class="bt"><i style="width:${(f.p[i] * 100).toFixed(1)}%"></i></span><span class="bv">${f.p[i].toFixed(2)}</span></div>`,
				)
				.join('');
			const wShown = f.t === 0 ? '→ ∞' : f.w.toFixed(2);
			vals.innerHTML = `
				<dt>t</dt><dd>${f.t.toFixed(3)}</dd>
				<dt>α<sub>t</sub>, σ<sub>t</sub></dt><dd>${alpha(f.t).toFixed(2)}, ${sigma(f.t).toFixed(2)}</dd>
				<dt>prior weight α/σ²</dt><dd>${wShown}</dd>
				<dt>z</dt><dd>(${f.z[0].toFixed(2)}, ${f.z[1].toFixed(2)})</dd>
				<dt>ê</dt><dd>(${f.ehat[0].toFixed(2)}, ${f.ehat[1].toFixed(2)})</dd>`;
			stepEl.textContent = last ? `Readout at t = 0: argmax = ${tokens[best].name}` : `Step ${k + 1} of ${N}: t = ${f.t.toFixed(3)} → ${(1 - (k + 1) / N).toFixed(3)}`;
			const ctx = ctxSel.value;
			if (k === 0)
				note.textContent =
					ctx === 'none'
						? 'No context: the transformer adds nothing, and at t = 1 the prior has zero weight, so all three tokens are equally likely and ê sits at their average.'
						: 'At t = 1 the state is pure noise and the prior has zero weight. The probabilities come from the context alone.';
			else if (last)
				note.textContent =
					ctx === 'none'
						? `Without context the answer is whichever embedding the noise happened to drift toward: a nearest-embedding lookup. Try New noise.`
						: `The context decided. Near t = 0 the prior weight grows without bound, but by then z already sits next to ${tokens[best].name}, so the two agree.`;
			else
				note.textContent =
					f.w > 3
						? 'Low noise: the prior weight is large, so the probabilities follow which embedding z is nearest to.'
						: 'Each step: probabilities → ê (their average) → DDIM moves z toward ê.';
			playBtn.textContent = timer ? 'Pause' : k >= N ? 'Replay' : 'Play';
		}
		function stop() {
			if (timer) clearInterval(timer);
			timer = undefined;
		}
		function rerun() {
			stop();
			frames = run(z1, ctxLogits[ctxSel.value]);
			k = 0;
			render();
		}
		playBtn.addEventListener('click', () => {
			if (timer) {
				stop();
				return render();
			}
			if (k >= N) k = 0;
			timer = window.setInterval(() => {
				k++;
				if (k >= N) stop();
				render();
			}, 900);
			render();
		});
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => {
			stop();
			k = Math.max(0, k - 1);
			render();
		});
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			stop();
			k = Math.min(N, k + 1);
			render();
		});
		fig.querySelector('[data-act="noise"]')!.addEventListener('click', () => {
			z1 = [gauss() * 0.8, gauss() * 0.8];
			rerun();
		});
		ctxSel.addEventListener('change', rerun);
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.ct {
		--c-tok: #2f6fb3;
		--c-z: #c2410c;
		--c-eh: #b7791f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .ct {
		--c-tok: #4f8fd6;
		--c-z: #e06a2c;
		--c-eh: #e0b04f;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .ct {
			--c-tok: #4f8fd6;
			--c-z: #e06a2c;
			--c-eh: #e0b04f;
		}
	}
	.ct:not(.ready) {
		display: none;
	}
	.ct-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.6rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px dashed var(--line);
	}
	.ct-sel {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font: 0.74rem var(--mono);
		color: var(--muted);
	}
	.ct-sel select {
		font: 0.78rem var(--mono);
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--surface);
		color: var(--fg);
	}
	.ct-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		margin-top: 0.8rem;
	}
	.ct-svg {
		width: 100%;
		height: auto;
	}
	.ct-svg :global(.ax) {
		stroke: var(--line);
	}
	.ct-svg :global(.unit) {
		fill: none;
		stroke: var(--faint);
		stroke-dasharray: 3 4;
	}
	.ct-svg :global(.tk) {
		fill: color-mix(in srgb, var(--c-tok) 25%, var(--surface));
		stroke: var(--c-tok);
		stroke-width: 1.5;
		transition: r 0.4s;
	}
	.ct-svg :global(.tk.win) {
		fill: var(--c-tok);
	}
	.ct-svg :global(.tl) {
		font: 600 13px var(--mono);
		fill: var(--fg);
	}
	.ct-svg :global(.path) {
		fill: none;
		stroke: var(--c-z);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
		opacity: 0.7;
	}
	.ct-svg :global(.arrow) {
		stroke: var(--c-eh);
		stroke-width: 1.5;
	}
	.ct-svg :global(.eh) {
		fill: var(--surface);
		stroke: var(--c-eh);
		stroke-width: 2;
	}
	.ct-svg :global(.z) {
		fill: var(--c-z);
		stroke: var(--surface);
		stroke-width: 2;
	}
	.ct-svg :global(.zl) {
		font: 12px var(--mono);
		fill: var(--c-z);
	}
	.ct-step {
		margin: 0 0 0.6rem;
		font: 600 0.78rem var(--mono);
	}
	.ct-bars :global(.bar) {
		display: grid;
		grid-template-columns: 2.4rem 1fr 2.6rem;
		align-items: center;
		gap: 0.4rem;
		margin: 0.3rem 0;
		font: 0.76rem var(--mono);
	}
	.ct-bars :global(.bt) {
		height: 0.8rem;
		border-radius: 3px;
		background: var(--code-bg);
		overflow: hidden;
	}
	.ct-bars :global(.bt i) {
		display: block;
		height: 100%;
		background: var(--c-tok);
		border-radius: 0 3px 3px 0;
		transition: width 0.4s;
	}
	.ct-bars :global(.bv) {
		text-align: right;
		color: var(--muted);
	}
	.ct-vals {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.15rem 0.8rem;
		margin: 0.8rem 0 0;
		font: 0.72rem var(--mono);
	}
	.ct-vals :global(dt) {
		color: var(--muted);
	}
	.ct-vals :global(dd) {
		margin: 0;
	}
	.ct-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0.6rem 0 0;
		font: 0.7rem var(--mono);
		color: var(--muted);
	}
	.ct-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
	}
	.sw.tok {
		background: color-mix(in srgb, var(--c-tok) 25%, var(--surface));
		border: 1.5px solid var(--c-tok);
	}
	.sw.z {
		background: var(--c-z);
	}
	.sw.eh {
		border-radius: 1px;
		transform: rotate(45deg) scale(0.8);
		border: 2px solid var(--c-eh);
	}
	.ct-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.ct {
			padding: 1rem;
		}
		.ct-body {
			grid-template-columns: 1fr;
		}
	}
</style>
