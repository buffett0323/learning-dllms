---
// MBD-LMs (arXiv 2606.29215) against single-block decoding and training-free multi-block decoding.
// Tab "Decoding": a toy run of 5 blocks × 4 tokens, one forward pass per step, all three lanes in sync.
//   Shared rules: the first active block commits 1 token per step. A block that finishes becomes "storing":
//   its clean K/V are written in the next forward pass, then it is cached.
//   - Single block (LLaDA2, SDAR as is): the next block starts only after the previous one is cached,
//     so every block costs one forward pass that commits nothing (the storing bubble of Fig. 1).
//   - Multi-block, training-free: append the next block once the last active one has 2/4 tokens. The input
//     holds whatever blocks are running, so its shape changes. The untrained model is cautious in the
//     second slot: toy rate one token every other step.
//   - MBD-LM + Block Buffer (N = 2): same admission rule, at most 2 real blocks; unused slots are dummies,
//     so the input is always 2 blocks. After MultiTF the second slot commits 1 token per step (toy rate).
// Tab "Training": what the model is trained on, around block 4, under each recipe. Resample redraws ratios.
// Rates are illustrative. The paper's averages on LLaDA2-Mini are 3.47 / 4.41 / 6.19 tokens per forward.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
---

<figure class="mbd" data-mbd>
	<div class="mbd-tabs" role="tablist" aria-label="View">
		<button type="button" role="tab" aria-selected="true" data-tab="dec">Decoding</button>
		<button type="button" role="tab" aria-selected="false" data-tab="train">Training states</button>
	</div>

	<div data-panel="dec">
		<div class="mbd-controls">
			<button class="btn primary" type="button" data-act="play">Play</button>
			<button class="btn icon" type="button" data-act="reset" aria-label="Reset">↺</button>
			<button class="btn icon" type="button" data-act="prev" aria-label="Previous step">‹</button>
			<button class="btn icon" type="button" data-act="next" aria-label="Next step">›</button>
			<span class="mbd-step" data-step></span>
		</div>
		<div class="mbd-lanes" data-lanes></div>
		<p class="mbd-legend" aria-hidden="true">
			<span><i class="sw mask"></i>[MASK]</span>
			<span><i class="sw tok"></i>committed</span>
			<span><i class="sw fresh"></i>committed this step</span>
			<span><i class="sw cache"></i>cached K/V</span>
			<span><i class="sw dummy"></i>dummy slot</span>
		</p>
	</div>

	<div data-panel="train" hidden>
		<div class="mbd-controls">
			<button class="btn" type="button" data-act="resample">Resample</button>
			<span class="mbd-step">Bar height = fraction of the block masked. Each row is one training sequence, seen from block 4.</span>
		</div>
		<div class="mbd-train" data-train></div>
		<p class="mbd-legend" aria-hidden="true">
			<span><i class="sw clean"></i>clean block</span>
			<span><i class="sw noisy"></i>noisy block (masked part)</span>
			<span><i class="sw grp"></i>MultiTF noise-group</span>
		</p>
	</div>

	<p class="mbd-note" data-note></p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type St = 'wait' | 'active' | 'tocache' | 'cache';
	type Frame = { slots: number[]; fresh: number[]; blocks: { n: number; st: St }[] };
	const K = 5;
	const B = 4;
	const TADD = 2;
	const N = 2;

	function sim(mode: 'single' | 'naive' | 'mbd'): Frame[] {
		const blocks = Array.from({ length: K }, () => ({ n: 0, st: 'wait' as St, age: 0 }));
		const frames: Frame[] = [{ slots: [], fresh: Array(K).fill(0), blocks: blocks.map((b) => ({ n: b.n, st: b.st })) }];
		let next = 0;
		const running = () => blocks.map((_, i) => i).filter((i) => blocks[i].st === 'active' || blocks[i].st === 'tocache');
		for (let guard = 0; guard < 100; guard++) {
			const r = running();
			if (mode === 'single') {
				if (!r.length && next < K) blocks[next++].st = 'active';
			} else if (next < K) {
				const last = r.length ? blocks[r[r.length - 1]] : null;
				const room = mode === 'mbd' ? r.length < N : true;
				if ((!last || last.st !== 'active' || last.n >= TADD) && room) blocks[next++].st = 'active';
			}
			const input = running();
			if (!input.length) break;
			const fresh = Array(K).fill(0);
			let slot = 0;
			for (const i of input) {
				const b = blocks[i];
				if (b.st === 'tocache') {
					b.st = 'cache';
					continue;
				}
				const rate = slot === 0 ? 1 : mode === 'naive' ? b.age % 2 : 1;
				const c = Math.min(rate, B - b.n);
				b.n += c;
				fresh[i] = c;
				b.age++;
				slot++;
			}
			for (const i of input) if (blocks[i].st === 'active' && blocks[i].n === B) blocks[i].st = 'tocache';
			const slots = mode === 'mbd' ? [...input, ...Array(N - input.length).fill(-1)] : input;
			frames.push({ slots, fresh, blocks: blocks.map((b) => ({ n: b.n, st: b.st })) });
			if (blocks.every((b) => b.st === 'cache')) break;
		}
		return frames;
	}

	const lanesDef = [
		{ id: 'single' as const, name: 'Single block', who: 'LLaDA2, SDAR as released', shape: 'one block' },
		{ id: 'naive' as const, name: 'Multi-block, training-free', who: 'D2F-style schedule, untrained model', shape: 'changes' },
		{ id: 'mbd' as const, name: 'MBD-LM + Block Buffer', who: 'after MultiTF, N = 2 slots', shape: 'fixed, 2 blocks' },
	];

	document.querySelectorAll<HTMLElement>('[data-mbd]').forEach((fig) => {
		const runs = lanesDef.map((l) => ({ ...l, frames: sim(l.id) }));
		const maxStep = Math.max(...runs.map((r) => r.frames.length - 1));
		const lanesEl = fig.querySelector<HTMLElement>('[data-lanes]')!;
		const stepEl = fig.querySelector<HTMLElement>('[data-step]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const playBtn = fig.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		let s = 0;
		let timer: number | undefined;

		function laneHTML(r: (typeof runs)[number]) {
			const last = r.frames.length - 1;
			const f = r.frames[Math.min(s, last)];
			const done = s >= last;
			const active = s > 0 && s <= last;
			let tokens = 0;
			let pos = 0;
			for (let k = 1; k <= Math.min(s, last); k++) pos += r.frames[k].slots.length * B;
			f.blocks.forEach((b) => (tokens += b.n));
			const steps = Math.min(s, last);
			const inInput = new Set(active ? f.slots : []);
			const blocks = f.blocks
				.map((b, i) => {
					const cells = Array.from({ length: B }, (_, j) => {
						const committed = j < b.n;
						const isFresh = active && committed && j >= b.n - f.fresh[i];
						return `<i class="c ${committed ? (isFresh ? 'fresh' : 'tok') : 'mask'}"></i>`;
					}).join('');
					const tag = b.st === 'cache' ? 'cached' : b.st === 'tocache' ? 'storing' : b.st === 'active' ? 'decoding' : '';
					const stored = active && f.slots.includes(i) && b.st === 'cache' && f.fresh[i] === 0;
					return `<span class="blk ${b.st === 'cache' ? 'cached' : ''} ${inInput.has(i) ? 'in' : ''}">
						<span class="cells">${cells}</span><small>${stored ? 'stored now' : tag || '&nbsp;'}</small></span>`;
				})
				.join('');
			const chips = active
				? f.slots
						.map((i) => {
							if (i < 0) return '<span class="chip dummy">dummy</span>';
							const b = f.blocks[i];
							const what = b.st === 'cache' && f.fresh[i] === 0 ? 'store' : 'decode';
							return `<span class="chip ${what}">B${i + 1} ${what}</span>`;
						})
						.join('')
				: done
					? `<span class="chip done">done in ${last} forward passes</span>`
					: '<span class="chip idle">—</span>';
			const tpf = steps ? (tokens / steps).toFixed(2) : '–';
			return `<div class="lane">
				<div class="lane-head"><b>${r.name}</b><small>${r.who}</small></div>
				<div class="lane-blocks">${blocks}</div>
				<div class="lane-input"><span class="k">forward input</span>${chips}</div>
				<div class="lane-stats">
					<span><b>${tokens}</b>/${K * B} tokens</span>
					<span><b>${tpf}</b> tokens / forward</span>
					<span><b>${pos}</b> positions computed</span>
					<span>input shape: ${r.shape}</span>
				</div>
			</div>`;
		}

		function render() {
			stepEl.textContent = s === 0 ? 'Before the first forward pass' : `Forward pass ${s}`;
			lanesEl.innerHTML = runs.map(laneHTML).join('');
			const single = runs[0].frames[Math.min(s, runs[0].frames.length - 1)];
			const bubble = s > 0 && s < runs[0].frames.length && single.fresh.every((x) => x === 0);
			note.textContent = bubble
				? 'Single block: this forward only stores the finished block. Nothing is committed — the storing bubble.'
				: s === 0
					? 'Same 20 tokens, same per-slot toy rates. Press Play, or step through.'
					: s >= maxStep
						? `Totals: ${runs.map((r) => `${r.name} ${r.frames.length - 1} passes`).join(', ')}. More blocks per pass means fewer passes, but more positions per pass, dummies included.`
						: '';
		}
		function stop() {
			if (timer) clearInterval(timer);
			timer = undefined;
			playBtn.textContent = 'Play';
		}
		playBtn.addEventListener('click', () => {
			if (timer) return stop();
			if (s >= maxStep) s = 0;
			playBtn.textContent = 'Pause';
			timer = window.setInterval(() => {
				s++;
				render();
				if (s >= maxStep) stop();
			}, 650);
		});
		fig.querySelector('[data-act="reset"]')!.addEventListener('click', () => {
			stop();
			s = 0;
			render();
		});
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => {
			stop();
			s = Math.max(0, s - 1);
			render();
		});
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => {
			stop();
			s = Math.min(maxStep, s + 1);
			render();
		});

		// Training states.
		const trainEl = fig.querySelector<HTMLElement>('[data-train]')!;
		const NB = 8;
		const u = (a: number, b: number) => a + Math.random() * (b - a);
		function trainRows() {
			// null = not in this sequence, 0 = clean, otherwise mask ratio.
			const inf: (number | null)[] = [0, 0, 0, u(0.05, 0.3), u(0.65, 0.95), null, null, null];
			const tf: (number | null)[] = [0, 0, 0, u(0.1, 0.95), null, null, null, null];
			const d2f = Array.from({ length: NB }, (_, i) => Math.min(0.95, Math.max(0.05, 0.3 + (0.4 * i) / (NB - 1) + u(-0.04, 0.04))));
			const g = 2 + Math.floor(Math.random() * 3);
			const mtf: (number | null)[] = [0, 0, 0];
			let floor = u(0, 0.6);
			for (let i = 0; i < g; i++) {
				floor = u(floor, 0.97);
				mtf.push(floor);
			}
			while (mtf.length < NB) mtf.push(null);
			return [
				{ name: 'At inference', who: 'what MultiBD actually decodes', v: inf, group: [3, 4] },
				{ name: 'Teacher forcing', who: 'BD3-LM, LLaDA2, SDAR', v: tf, group: null },
				{ name: 'Diffusion forcing', who: 'D2F: every block noisy, smooth rise', v: d2f, group: null },
				{ name: 'MultiTF', who: `clean prefix + a group of ${g}, chain-uniform`, v: mtf, group: [3, 3 + g - 1] },
			];
		}
		function renderTrain() {
			trainEl.innerHTML = trainRows()
				.map((r) => {
					const bars = r.v
						.map((t, i) => {
							const inG = r.group && i >= r.group[0] && i <= r.group[1];
							if (t === null) return `<span class="bar none"><small>${i + 1}</small></span>`;
							if (t === 0) return `<span class="bar clean ${inG ? 'g' : ''}"><small>${i + 1}</small></span>`;
							return `<span class="bar noisy ${inG ? 'g' : ''}" style="--t:${t}"><i></i><small>${Math.round(t * 100)}%</small></span>`;
						})
						.join('');
					return `<div class="trow"><span class="lane-head"><b>${r.name}</b><small>${r.who}</small></span><span class="bars">${bars}</span></div>`;
				})
				.join('');
			note.textContent =
				'Inference has a clean prefix and about two noisy blocks far apart in masking. Teacher forcing never shows two noisy blocks; diffusion forcing shows many, with similar ratios. MultiTF trains on the inference shape.';
		}
		fig.querySelector('[data-act="resample"]')!.addEventListener('click', renderTrain);

		fig.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((tab) =>
			tab.addEventListener('click', () => {
				stop();
				fig.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
				fig.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== tab.dataset.tab));
				if (tab.dataset.tab === 'train') renderTrain();
				else render();
			}),
		);
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.mbd {
		--c-act: #c2410c;
		--c-tok: #b7791f;
		--c-cache: #2f7d4f;
		--c-grp: #2f6fb3;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .mbd {
		--c-act: #e06a2c;
		--c-tok: #e0b04f;
		--c-cache: #4fb07a;
		--c-grp: #4f8fd6;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .mbd {
			--c-act: #e06a2c;
			--c-tok: #e0b04f;
			--c-cache: #4fb07a;
			--c-grp: #4f8fd6;
		}
	}
	.mbd:not(.ready) {
		display: none;
	}
	.mbd-tabs {
		display: inline-flex;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 2px;
		margin-bottom: 0.9rem;
	}
	.mbd-tabs button {
		border: 0;
		background: none;
		padding: 0.3rem 0.9rem;
		border-radius: 999px;
		font: 0.78rem var(--mono);
		color: var(--muted);
		cursor: pointer;
	}
	.mbd-tabs button[aria-selected='true'] {
		background: var(--code-bg);
		color: var(--fg);
		font-weight: 600;
	}
	.mbd-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.6rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px dashed var(--line);
	}
	.mbd-step {
		font: 0.74rem var(--mono);
		color: var(--muted);
	}
	.mbd-lanes {
		display: grid;
		gap: 0.9rem;
		margin-top: 0.9rem;
	}
	.mbd-lanes :global(.lane) {
		display: grid;
		gap: 0.4rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--line);
	}
	.mbd :global(.lane-head) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.6rem;
	}
	.mbd :global(.lane-head b) {
		font: 600 0.8rem var(--mono);
	}
	.mbd :global(.lane-head small) {
		font-size: 0.72rem;
		color: var(--muted);
	}
	.mbd-lanes :global(.lane-blocks) {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.mbd-lanes :global(.blk) {
		display: grid;
		gap: 2px;
		padding: 3px;
		border: 1.5px solid transparent;
		border-radius: 5px;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.mbd-lanes :global(.blk.in) {
		border-color: var(--c-act);
	}
	.mbd-lanes :global(.blk.cached) {
		background: color-mix(in srgb, var(--c-cache) 16%, var(--surface));
	}
	.mbd-lanes :global(.blk small) {
		font: 0.62rem var(--mono);
		color: var(--muted);
		text-align: center;
	}
	.mbd-lanes :global(.cells) {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2px;
	}
	.mbd-lanes :global(.c) {
		height: 1.1rem;
		border-radius: 2px;
	}
	.mbd :global(.c.mask),
	.sw.mask {
		border: 1px dashed var(--line);
		background: var(--surface);
	}
	.mbd :global(.c.tok),
	.sw.tok {
		background: color-mix(in srgb, var(--c-tok) 45%, var(--surface));
	}
	.mbd :global(.c.fresh),
	.sw.fresh {
		background: var(--c-act);
	}
	.mbd-lanes :global(.blk.cached .c.tok) {
		background: color-mix(in srgb, var(--c-cache) 50%, var(--surface));
	}
	.mbd-lanes :global(.lane-input) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
		min-height: 1.5rem;
	}
	.mbd-lanes :global(.k) {
		font: 0.66rem var(--mono);
		color: var(--muted);
		margin-right: 0.2rem;
	}
	.mbd-lanes :global(.chip) {
		font: 0.68rem var(--mono);
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
		border: 1px solid var(--line);
	}
	.mbd-lanes :global(.chip.decode) {
		border-color: var(--c-act);
	}
	.mbd-lanes :global(.chip.store) {
		border-color: var(--c-cache);
		background: color-mix(in srgb, var(--c-cache) 14%, var(--surface));
	}
	.mbd-lanes :global(.chip.dummy),
	.sw.dummy {
		background: repeating-linear-gradient(-45deg, transparent 0 3px, color-mix(in srgb, var(--muted) 30%, transparent) 3px 4px);
		color: var(--muted);
	}
	.mbd-lanes :global(.chip.idle),
	.mbd-lanes :global(.chip.done) {
		color: var(--muted);
	}
	.mbd-lanes :global(.lane-stats) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1.1rem;
		font: 0.7rem var(--mono);
		color: var(--muted);
	}
	.mbd-lanes :global(.lane-stats b) {
		color: var(--fg);
	}
	.mbd-train {
		display: grid;
		gap: 0.9rem;
		margin-top: 0.9rem;
	}
	.mbd-train :global(.trow) {
		display: grid;
		gap: 0.35rem;
	}
	.mbd-train :global(.bars) {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: 0.4rem;
	}
	.mbd-train :global(.bar) {
		position: relative;
		height: 3.2rem;
		border-radius: 4px;
		border: 1px solid var(--line);
		overflow: hidden;
	}
	.mbd-train :global(.bar.none) {
		border-style: dotted;
		opacity: 0.6;
	}
	.mbd-train :global(.bar.clean),
	.sw.clean {
		background: color-mix(in srgb, var(--c-cache) 22%, var(--surface));
	}
	.mbd-train :global(.bar.noisy) {
		background: color-mix(in srgb, var(--c-tok) 22%, var(--surface));
	}
	.mbd-train :global(.bar.noisy i),
	.sw.noisy {
		background: repeating-linear-gradient(-45deg, color-mix(in srgb, var(--c-act) 55%, var(--surface)) 0 4px, color-mix(in srgb, var(--c-act) 35%, var(--surface)) 4px 6px);
	}
	.mbd-train :global(.bar.noisy i) {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: calc(var(--t) * 100%);
		transition: height 0.35s;
	}
	.mbd-train :global(.bar.g) {
		outline: 2px solid var(--c-grp);
		outline-offset: 1px;
	}
	.sw.grp {
		outline: 2px solid var(--c-grp);
		outline-offset: -2px;
	}
	.mbd-train :global(.bar small) {
		position: absolute;
		bottom: 2px;
		left: 0;
		right: 0;
		text-align: center;
		font: 0.62rem var(--mono);
		color: var(--fg);
	}
	.mbd-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0.8rem 0 0;
		font: 0.7rem var(--mono);
		color: var(--muted);
	}
	.mbd-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
	}
	.sw.cache {
		background: color-mix(in srgb, var(--c-cache) 50%, var(--surface));
	}
	.mbd-note {
		margin: 0.6rem 0 0;
		min-height: 2.6em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.mbd {
			padding: 1rem;
		}
		.mbd-lanes :global(.lane-blocks) {
			gap: 0.25rem;
		}
		.mbd-train :global(.bars) {
			gap: 0.2rem;
		}
	}
</style>
