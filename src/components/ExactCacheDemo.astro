---
// Which cached K/V are exact, step by step. Same toy as BlockCacheDemo (P01) so the two can be compared.
// A cached entry is stale if a position it attends to changed after it was written; the badge counts
// those changes. Three modes:
// - full: full attention + Fast-dLLM DualCache. Refresh everything at the first step of a block.
// - bd: block-causal (BD3-LM). Run the current block; prefix from cache. The first step of a block also
//   runs the previous block on its clean tokens to write its K/V (BD3-LM Alg. 2 runs this as its own
//   pass; with the block-causal mask it can share the forward pass, the result is the same).
// - v2: block-causal + Fast-dLLM v2's sub-block DualCache: inside the block, run one sub-block and
//   reuse the rest of the block, refreshed at each sub-block start.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const prompt = ['Q', ':', 'where', '?'];
const answer = ['It', 'is', 'in', 'the', 'north', 'of', 'France', ',', 'on', 'the', 'Seine', '.'];
const block = 4;
const sub = 2;
// Decoding order inside each block (offsets 0..3), one token per step. Sub-block 0 first, then sub-block 1.
const order = [1, 0, 3, 2];
---

<figure class="xc" data-xc data-config={JSON.stringify({ prompt, answer, block, sub, order })}>
	<div class="xc-controls">
		<div class="xc-modes" role="radiogroup" aria-label="Model and cache">
			<button type="button" role="radio" aria-checked="false" data-mode="full">Full attn + DualCache</button>
			<button type="button" role="radio" aria-checked="true" data-mode="bd">Block-causal</button>
			<button type="button" role="radio" aria-checked="false" data-mode="v2">+ sub-block cache</button>
		</div>
		<div class="xc-buttons">
			<button class="btn icon" type="button" data-act="reset" aria-label="Reset">↺</button>
			<button class="btn" type="button" data-act="all">All steps</button>
			<button class="btn primary" type="button" data-act="next">Next step</button>
		</div>
	</div>

	<div class="xc-scroll">
		<div class="xc-head" style={`--cols:${prompt.length + answer.length}`}>
			<span></span>
			<span class="xc-span" style={`grid-column: span ${prompt.length}`}>prompt</span>
			{
				Array.from({ length: answer.length / block }, (_, b) => (
					<span class="xc-span" style={`grid-column: span ${block}`}>
						block {b}
					</span>
				))
			}
		</div>
		<div class="xc-rows" data-rows style={`--cols:${prompt.length + answer.length}`}></div>
	</div>

	<p class="xc-legend" aria-hidden="true">
		<span><i class="sw run"></i>computed</span>
		<span><i class="sw write"></i>computed, written to cache</span>
		<span><i class="sw exact"></i>cache, exact</span>
		<span><i class="sw stale"></i>cache, stale (n = changes missed)</span>
		<span><i class="sw absent"></i>not appended yet</span>
	</p>
	<p class="xc-note" data-note></p>
	<div class="xc-totals" data-totals></div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type Mode = 'full' | 'bd' | 'v2';
	type State = 'run' | 'write' | 'cache' | 'absent';
	const MODES: Mode[] = ['full', 'bd', 'v2'];
	const LABEL: Record<Mode, string> = { full: 'Full attn + DualCache', bd: 'Block-causal', v2: '+ sub-block cache' };

	document.querySelectorAll<HTMLElement>('[data-xc]').forEach((fig) => {
		const { prompt, answer, block, sub, order } = JSON.parse(fig.dataset.config!) as {
			prompt: string[];
			answer: string[];
			block: number;
			sub: number;
			order: number[];
		};
		const P = prompt.length;
		const N = answer.length;
		const L = P + N;
		const steps = N;
		const blockOf = (i: number) => (i < P ? -1 : Math.floor((i - P) / block));
		// decodedAt[i]: the step whose output commits position i (prompt: -1, given).
		const decodedAt = Array.from({ length: L }, () => -1);
		for (let s = 0; s < steps; s++) decodedAt[P + Math.floor(s / block) * block + order[s % block]] = s;
		const rowsEl = fig.querySelector<HTMLElement>('[data-rows]')!;
		const note = fig.querySelector<HTMLElement>('[data-note]')!;
		const totals = fig.querySelector<HTMLElement>('[data-totals]')!;
		let mode: Mode = 'bd';
		let shown = 0;

		// States of every position at step s.
		function states(m: Mode, s: number): State[] {
			const b = Math.floor(s / block);
			const j = s % block;
			const start = P + b * block;
			return Array.from({ length: L }, (_, i) => {
				const bi = blockOf(i);
				const inBlock = bi === b;
				if (m === 'full') {
					if (inBlock) return 'run';
					return j === 0 ? 'write' : 'cache';
				}
				if (bi > b) return 'absent';
				if (bi === -1) return s === 0 ? 'write' : 'cache';
				if (bi === b - 1) return j === 0 ? 'write' : 'cache';
				if (bi < b) return 'cache';
				if (m === 'bd') return 'run';
				// v2: the current sub-block runs; the rest of the block is refreshed at each sub-block start.
				const curSub = Math.floor(order[j] / sub);
				if (Math.floor((i - start) / sub) === curSub) return 'run';
				return j % sub === 0 ? 'write' : 'cache';
			});
		}
		// What each position attends to.
		const scope = (m: Mode, i: number) =>
			m === 'full' ? Array.from({ length: L }, (_, q) => q) : Array.from({ length: L }, (_, q) => q).filter((q) => blockOf(q) <= blockOf(i));

		// Replay the run: writtenAt[i] = step whose input the cached entry was computed from.
		function replay(m: Mode, upto: number) {
			const writtenAt = Array.from({ length: L }, () => -1);
			const rows: { st: State[]; miss: number[]; computed: number; reads: number; stale: number }[] = [];
			for (let s = 0; s < upto; s++) {
				const st = states(m, s);
				const miss = st.map((x, i) => {
					if (x !== 'cache') return 0;
					const w = writtenAt[i];
					return scope(m, i).filter((q) => decodedAt[q] >= w && decodedAt[q] < s).length;
				});
				st.forEach((x, i) => {
					if (x === 'write') writtenAt[i] = s;
				});
				rows.push({
					st,
					miss,
					computed: st.filter((x) => x === 'run' || x === 'write').length,
					reads: st.filter((x) => x === 'cache').length,
					stale: miss.filter((n) => n > 0).length,
				});
			}
			return rows;
		}
		const sum = (m: Mode) =>
			replay(m, steps).reduce((a, r) => ({ computed: a.computed + r.computed, reads: a.reads + r.reads, stale: a.stale + r.stale }), {
				computed: 0,
				reads: 0,
				stale: 0,
			});

		function render() {
			const rows = replay(mode, shown);
			rowsEl.innerHTML = rows
				.map((r, s) => {
					const cells = r.st
						.map((x, i) => {
							const known = decodedAt[i] < s;
							const tok = x === 'absent' ? '' : i < P ? prompt[i] : known ? answer[i - P] : '';
							const kind = x === 'cache' ? (r.miss[i] ? 'stale' : 'exact') : x;
							const cls = ['xc-cell', kind, x !== 'absent' && !known ? 'mask' : '', decodedAt[i] === s ? 'fresh' : ''].join(' ');
							const badge = kind === 'stale' ? ` data-miss="${r.miss[i]}"` : '';
							return `<span class="${cls}"${badge}>${tok}</span>`;
						})
						.join('');
					return `<span class="xc-step">step ${s + 1}<small>${r.computed}</small></span>${cells}`;
				})
				.join('');

			if (shown === 0) {
				note.textContent = `${P} prompt tokens, ${N} answer tokens in blocks of ${block}, one token per step. The number after "step" is how many positions run. Press Next step.`;
			} else {
				const s = shown - 1;
				const b = Math.floor(s / block);
				const j = s % block;
				const r = rows[s];
				note.textContent =
					mode === 'full'
						? j === 0
							? `First step of block ${b}: all ${L} positions run and refresh the cache.`
							: `Inside block ${b}: ${r.reads} positions come from the cache, and all of them are stale. Each attends to the whole sequence, which has changed ${j} time${j > 1 ? 's' : ''} since the refresh.`
						: mode === 'bd'
							? j === 0 && b > 0
								? `Block ${b - 1} is finished. Its last pass still had a mask in it, so this step also runs it on its clean tokens and writes its K/V. They never change again.`
								: `Only block ${b} runs. All ${r.reads} cached positions are exact: they attend to the prompt and finished blocks only, and none of those change again.`
							: r.stale
								? `The prefix is still exact. But the other sub-block of block ${b} comes from the cache, and it attends to the token just decoded: ${r.stale} stale entries, all inside the current block.`
								: `First step of sub-block ${Math.floor(order[j] / sub)} in block ${b}: the whole block runs and refreshes the sub-block cache${j === 0 && b > 0 ? `, and block ${b - 1} is written to the exact cache` : ''}.`;
			}

			const t = { full: sum('full'), bd: sum('bd'), v2: sum('v2') };
			totals.innerHTML = MODES.map(
				(m) =>
					`<div class="${m === mode ? 'on' : ''}"><span>${LABEL[m]}</span><b>${t[m].computed}</b><small>positions computed · ${t[m].stale} of ${t[m].reads} cache reads stale</small></div>`,
			).join('');
			fig.querySelector<HTMLButtonElement>('[data-act="next"]')!.disabled = shown >= steps;
			fig.querySelector<HTMLButtonElement>('[data-act="all"]')!.disabled = shown >= steps;
			fig.querySelector<HTMLButtonElement>('[data-act="reset"]')!.disabled = shown === 0;
		}

		fig.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) =>
			btn.addEventListener('click', () => {
				mode = btn.dataset.mode as Mode;
				fig.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
				render();
			}),
		);
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => ((shown = Math.min(steps, shown + 1)), render()));
		fig.querySelector('[data-act="all"]')!.addEventListener('click', () => ((shown = steps), render()));
		fig.querySelector('[data-act="reset"]')!.addEventListener('click', () => ((shown = 0), render()));
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.xc {
		--c-run: #c2410c;
		--c-exact: #2f6fb3;
		--c-stale: #b7791f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .xc {
		--c-run: #e06a2c;
		--c-exact: #4f8fd6;
		--c-stale: #d69e2e;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .xc {
			--c-run: #e06a2c;
			--c-exact: #4f8fd6;
			--c-stale: #d69e2e;
		}
	}
	.xc:not(.ready) {
		display: none;
	}
	.xc-controls {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed var(--line);
	}
	.xc-modes {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		gap: 2px;
		border-radius: 8px;
		background: var(--code-bg);
	}
	.xc-modes button {
		padding: 0.35rem 0.7rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--muted);
		font: 0.76rem var(--mono);
		cursor: pointer;
	}
	.xc-modes button[aria-checked='true'] {
		background: var(--surface);
		color: var(--fg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
	}
	.xc-buttons {
		display: flex;
		gap: 0.4rem;
	}
	.xc-scroll {
		overflow-x: auto;
	}
	.xc-head,
	.xc-rows {
		display: grid;
		grid-template-columns: 3.6rem repeat(var(--cols), minmax(1.7rem, 1fr));
		gap: 2px;
		min-width: 32rem;
	}
	.xc-head {
		margin-top: 1rem;
	}
	.xc-span {
		padding-bottom: 0.25rem;
		border-bottom: 2px solid var(--line);
		text-align: center;
		font-family: var(--mono);
		font-size: 0.66rem;
		color: var(--muted);
	}
	.xc-rows {
		margin-top: 4px;
		row-gap: 3px;
		align-items: center;
	}
	.xc-rows :global(.xc-step) {
		display: flex;
		justify-content: space-between;
		gap: 0.2rem;
		padding-right: 0.3rem;
		font-family: var(--mono);
		font-size: 0.62rem;
		color: var(--muted);
	}
	.xc-rows :global(.xc-step small) {
		color: var(--fg);
		font-size: 0.62rem;
	}
	.xc-rows :global(.xc-cell) {
		position: relative;
		height: 1.45rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 3px;
		font-family: var(--mono);
		font-size: 0.58rem;
		white-space: nowrap;
	}
	.xc-rows :global(.xc-cell.run) {
		background-color: color-mix(in srgb, var(--c-run) 30%, var(--surface));
	}
	.xc-rows :global(.xc-cell.write) {
		background-color: color-mix(in srgb, var(--c-run) 30%, var(--surface));
		box-shadow: inset 0 -3px 0 var(--c-exact);
	}
	.xc-rows :global(.xc-cell.exact) {
		background-color: color-mix(in srgb, var(--c-exact) 18%, var(--surface));
		color: var(--muted);
	}
	.xc-rows :global(.xc-cell.stale) {
		background-color: color-mix(in srgb, var(--c-stale) 24%, var(--surface));
		color: var(--muted);
	}
	.xc-rows :global(.xc-cell.stale::after) {
		content: attr(data-miss);
		position: absolute;
		top: 0;
		right: 2px;
		font-size: 0.5rem;
		font-weight: 700;
		color: var(--c-stale);
	}
	.xc-rows :global(.xc-cell.absent) {
		border: 1px dotted var(--line);
	}
	.xc-rows :global(.xc-cell.mask) {
		background-image: repeating-linear-gradient(-45deg, transparent 0 3px, rgb(0 0 0 / 0.12) 3px 4px);
	}
	.xc-rows :global(.xc-cell.fresh) {
		box-shadow: inset 0 0 0 1.5px var(--c-run);
		font-weight: 600;
	}
	.xc-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0.9rem 0 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.xc-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		border-radius: 3px;
	}
	.sw.run {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
	}
	.sw.write {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
		box-shadow: inset 0 -3px 0 var(--c-exact);
	}
	.sw.exact {
		background: color-mix(in srgb, var(--c-exact) 18%, var(--surface));
	}
	.sw.stale {
		background: color-mix(in srgb, var(--c-stale) 24%, var(--surface));
	}
	.sw.absent {
		border: 1px dotted var(--muted);
	}
	.xc-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.xc-totals {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
		margin-top: 0.6rem;
		padding-top: 0.8rem;
		border-top: 1px dashed var(--line);
	}
	.xc-totals :global(div) {
		display: grid;
		gap: 0.05rem;
		padding: 0.5rem 0.6rem;
		border-radius: 8px;
	}
	.xc-totals :global(div.on) {
		background: var(--code-bg);
	}
	.xc-totals :global(span) {
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.xc-totals :global(b) {
		font-family: var(--mono);
		font-size: 1.25rem;
	}
	.xc-totals :global(small) {
		font-size: 0.78rem;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.xc {
			padding: 1rem;
		}
		.xc-totals {
			grid-template-columns: 1fr;
		}
	}
</style>
