---
// Two models decode the same answer block by block, one token per step.
// Top: full attention (LLaDA, Dream) with semi-autoregressive sampling. Bottom: block diffusion
// (block-causal attention). The decoding order is identical; only the attention mask differs.
// Each lane shows the input at this step and a block-level attention matrix (row sees column).
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const prompt = ['Q:', 'where', 'is', 'it?'];
const answer = ['It', 'is', 'in', 'Paris', ',', 'on', 'the', 'Seine', '.', 'eos', 'eos', 'eos'];
const block = 4;
// Decoding order inside each block (offsets), one token per step.
const order = [1, 0, 3, 2];
const P = prompt.length;
const N = answer.length;
const groups = ['prompt', ...Array.from({ length: N / block }, (_, b) => `block ${b + 1}`)];
const short = (g: string) => (g === 'prompt' ? 'P' : `B${g.slice(6)}`);
const lanes = [
	{ id: 'full', name: 'Full attention, decoded block by block', who: 'LLaDA, Dream (semi-AR sampling)' },
	{ id: 'block', name: 'Block diffusion', who: 'BD3-LM, SDAR, Fast-dLLM v2, LLaDA 2.0' },
];
---

<figure class="bvf" data-bvf data-config={JSON.stringify({ prompt, answer, block, order })}>
	<div class="bvf-controls">
		<button class="btn icon" type="button" data-act="reset" aria-label="Reset">↺</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Previous step">‹</button>
		<span class="bvf-step" data-step></span>
		<button class="btn icon" type="button" data-act="next" aria-label="Next step">›</button>
		<button class="btn primary" type="button" data-act="play">Play</button>
	</div>

	{
		lanes.map((l) => (
			<section class="bvf-lane" data-lane={l.id}>
				<header>
					<b>{l.name}</b>
					<span>{l.who}</span>
				</header>
				<div class="bvf-body">
					<div class="bvf-left">
						<div class="bvf-groups" style={`--cols:${P + N}`}>
							{groups.map((g, i) => (
								<span style={`grid-column: span ${i === 0 ? P : block}`}>{g}</span>
							))}
						</div>
						<div class="bvf-strip" style={`--cols:${P + N}`} data-strip>
							{Array.from({ length: P + N }, () => (
								<span class="bvf-cell" />
							))}
						</div>
						<p class="bvf-count" data-count />
					</div>
					<div class="bvf-right">
						<div class="bvf-matrix" style={`--g:${groups.length}`} role="img" aria-label="Block-level attention matrix">
							<span />
							{groups.map((g) => (
								<span class="bvf-mh">{short(g)}</span>
							))}
							{groups.map((g, r) => [
								<span class="bvf-mh">{short(g)}</span>,
								...groups.map((_, k) => <span class="bvf-m" data-r={r} data-k={k} />),
							])}
						</div>
						<p class="bvf-mcap">row attends to column</p>
					</div>
				</div>
				<p class="bvf-note" data-note />
			</section>
		))
	}

	<p class="bvf-legend" aria-hidden="true">
		<span><i class="sw run"></i>computed this step</span>
		<span><i class="sw drift"></i>recomputed: its K/V changed</span>
		<span><i class="sw cache"></i>read from cache (exact)</span>
		<span><i class="sw write"></i>computed once, written to cache</span>
		<span><i class="sw mask"></i>[MASK]</span>
		<span><i class="sw void"></i>not in the input yet</span>
		<span><i class="sw hot"></i>attends to the block that is changing</span>
		<span><i class="sw blocked">✕</i>cannot attend</span>
	</p>
	<div class="bvf-totals" data-totals></div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	type Lane = 'full' | 'block';

	document.querySelectorAll<HTMLElement>('[data-bvf]').forEach((fig) => {
		const { prompt, answer, block, order } = JSON.parse(fig.dataset.config!) as {
			prompt: string[];
			answer: string[];
			block: number;
			order: number[];
		};
		const P = prompt.length;
		const N = answer.length;
		const nb = N / block;
		const steps = N;
		let s = 0;
		let timer: number | undefined;

		// Block of the forward pass at step s (0-based); step 0 is the starting input.
		const cur = (t: number) => (t === 0 ? 0 : Math.floor((t - 1) / block));
		// Group of position i: -1 for the prompt, else the answer block.
		const groupOf = (i: number) => (i < P ? -1 : Math.floor((i - P) / block));
		const decodedAfter = (t: number) => {
			const d = new Set<number>();
			for (let u = 0; u < t; u++) d.add(P + Math.floor(u / block) * block + order[u % block]);
			return d;
		};
		// Block diffusion writes a group's K/V once: the prompt at step 1, block b at the first step of block b+1.
		const writes = (t: number, g: number) => t > 0 && (t - 1) % block === 0 && g === cur(t) - 1;

		function cells(lane: Lane, t: number) {
			const c = cur(t);
			const dec = decodedAfter(t);
			const fresh = t > 0 ? P + c * block + order[(t - 1) % block] : -1;
			return Array.from({ length: P + N }, (_, i) => {
				const g = groupOf(i);
				const tok = i < P ? prompt[i] : dec.has(i) ? answer[i - P] : '';
				const masked = i >= P && !dec.has(i);
				let st: string;
				if (lane === 'block' && g > c) return { cls: 'void', tok: '' };
				if (t === 0) st = 'idle';
				else if (lane === 'full') st = g < c ? 'drift' : 'run';
				else st = g === c ? 'run' : writes(t, g) ? 'write' : 'cache';
				return { cls: [st, masked ? 'mask' : '', i === fresh ? 'fresh' : ''].join(' '), tok };
			});
		}

		function computed(lane: Lane, t: number) {
			if (t === 0) return 0;
			if (lane === 'full') return P + N;
			const c = cur(t);
			return block + (writes(t, c - 1) ? (c === 0 ? P : block) : 0);
		}
		const total = (lane: Lane, upTo: number) => {
			let sum = 0;
			for (let u = 1; u <= upTo; u++) sum += computed(lane, u);
			return sum;
		};

		function matrix(lane: Lane, t: number, r: number, k: number) {
			const cg = cur(t) + 1; // matrix index of the current block (0 is the prompt)
			const allowed = lane === 'full' || k <= r;
			const exists = lane === 'full' || (r <= cg && k <= cg);
			if (!exists) return 'gone';
			if (!allowed) return r < cg && k === cg ? 'off blocked' : 'off';
			if (lane === 'full') return r < cg && k === cg ? 'hot' : r === cg ? 'run' : 'on';
			if (r === cg) return k < cg ? 'read' : 'run';
			return 'frozen';
		}

		const range = (c: number) => (c === 1 ? 'block 1' : `blocks 1–${c}`);

		function note(lane: Lane, t: number) {
			const c = cur(t);
			if (lane === 'full') {
				if (t === 0) return `The canvas is fixed before decoding starts: ${P} prompt tokens plus ${N} masks. Every position attends to every other.`;
				const right = (nb - 1 - c) * block;
				const before = c === 0 ? 'The prompt attends' : `The prompt and ${range(c)} attend`;
				let text = `Decoding block ${c + 1}. ${before} to block ${c + 1}, which just changed, so their K/V changed too (red): a cache of them would be stale. All ${P + N} positions are recomputed`;
				text += right ? `, including the ${right} masks to the right.` : '.';
				if (t === steps) text += ' Its length was fixed at the start, so a longer answer would not fit.';
				return text;
			}
			if (t === 0) return `Only the prompt and block 1 are in the input. Later blocks do not exist yet.`;
			let text = `Decoding block ${c + 1}: only its ${block} positions run. Earlier blocks never attend to block ${c + 1} (✕), so their K/V are final: an exact cache, as in AR.`;
			if (writes(t, c - 1)) text += ` This step also computes ${c === 0 ? 'the prompt' : `block ${c}`} once and writes it to the cache.`;
			if (t === steps) text += ' eos appeared, so generation stops here. A longer answer would simply append block 4.';
			return text;
		}

		function render() {
			fig.querySelectorAll<HTMLElement>('[data-lane]').forEach((laneEl) => {
				const lane = laneEl.dataset.lane as Lane;
				const cs = cells(lane, s);
				laneEl.querySelectorAll<HTMLElement>('.bvf-cell').forEach((el, i) => {
					el.className = `bvf-cell ${cs[i].cls}`;
					el.textContent = cs[i].tok;
				});
				laneEl.querySelectorAll<HTMLElement>('.bvf-m').forEach((el) => {
					const st = matrix(lane, s, Number(el.dataset.r), Number(el.dataset.k));
					el.className = `bvf-m ${st}`;
					el.textContent = st.includes('blocked') ? '✕' : '';
				});
				laneEl.querySelector<HTMLElement>('[data-count]')!.textContent =
					s === 0 ? 'positions computed this step: –' : `positions computed this step: ${computed(lane, s)}`;
				laneEl.querySelector<HTMLElement>('[data-note]')!.textContent = note(lane, s);
			});
			fig.querySelector<HTMLElement>('[data-step]')!.textContent = s === 0 ? 'start' : `step ${s} / ${steps}`;
			const tf = total('full', s);
			const tb = total('block', s);
			fig.querySelector<HTMLElement>('[data-totals]')!.innerHTML =
				`<div><span>Full attention</span><b>${tf}</b><small>positions computed so far</small></div>` +
				`<div><span>Block diffusion</span><b>${tb}</b><small>${s ? `${(tf / tb).toFixed(1)}× fewer, and every cached K/V is exact` : 'positions computed so far'}</small></div>`;
			fig.querySelector<HTMLButtonElement>('[data-act="prev"]')!.disabled = s === 0;
			fig.querySelector<HTMLButtonElement>('[data-act="reset"]')!.disabled = s === 0;
			fig.querySelector<HTMLButtonElement>('[data-act="next"]')!.disabled = s >= steps;
			fig.querySelector<HTMLButtonElement>('[data-act="play"]')!.textContent = timer ? 'Pause' : s >= steps ? 'Replay' : 'Play';
		}

		const stop = () => {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		};
		const go = (t: number) => ((s = Math.max(0, Math.min(steps, t))), render());
		fig.querySelector('[data-act="next"]')!.addEventListener('click', () => (stop(), go(s + 1)));
		fig.querySelector('[data-act="prev"]')!.addEventListener('click', () => (stop(), go(s - 1)));
		fig.querySelector('[data-act="reset"]')!.addEventListener('click', () => (stop(), go(0)));
		fig.querySelector('[data-act="play"]')!.addEventListener('click', () => {
			if (timer) return stop(), render();
			if (s >= steps) s = 0;
			timer = window.setInterval(() => {
				if (s >= steps) return stop(), render();
				go(s + 1);
				if (s >= steps) stop(), render();
			}, 1100);
			render();
		});
		fig.classList.add('ready');
		render();
	});
</script>

<style>
	.bvf {
		--c-run: #c2410c;
		--c-drift: #b42318;
		--c-cache: #2f7d4f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .bvf {
		--c-run: #e06a2c;
		--c-drift: #f0605a;
		--c-cache: #4fb07a;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .bvf {
			--c-run: #e06a2c;
			--c-drift: #f0605a;
			--c-cache: #4fb07a;
		}
	}
	.bvf:not(.ready) {
		display: none;
	}
	.bvf-controls {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed var(--line);
	}
	.bvf-step {
		min-width: 6.5rem;
		text-align: center;
		font-family: var(--mono);
		font-size: 0.78rem;
	}
	.bvf-controls [data-act='play'] {
		margin-left: auto;
	}
	.bvf-lane {
		margin-top: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed var(--line);
	}
	.bvf-lane header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.2rem 0.7rem;
		margin-bottom: 0.6rem;
	}
	.bvf-lane header b {
		font-family: var(--mono);
		font-size: 0.78rem;
	}
	.bvf-lane header span {
		font-size: 0.82rem;
		color: var(--muted);
	}
	.bvf-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.1rem;
		align-items: start;
	}
	.bvf-groups,
	.bvf-strip {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: 2px;
	}
	.bvf-groups span {
		padding-bottom: 0.2rem;
		border-bottom: 2px solid var(--line);
		text-align: center;
		font-family: var(--mono);
		font-size: 0.64rem;
		color: var(--muted);
	}
	.bvf-strip {
		margin-top: 4px;
	}
	.bvf-cell {
		height: 1.9rem;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 3px;
		font-family: var(--mono);
		font-size: 0.56rem;
		white-space: nowrap;
		background: var(--code-bg);
		transition:
			background-color 0.35s,
			box-shadow 0.35s,
			opacity 0.35s;
	}
	.bvf-cell.run {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
	}
	.bvf-cell.drift {
		background: color-mix(in srgb, var(--c-drift) 30%, var(--surface));
	}
	.bvf-cell.cache {
		background: color-mix(in srgb, var(--c-cache) 22%, var(--surface));
		color: var(--muted);
	}
	.bvf-cell.write {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
		box-shadow: inset 0 -3px 0 var(--c-cache);
	}
	.bvf-cell.mask {
		background-image: repeating-linear-gradient(-45deg, transparent 0 3px, rgb(0 0 0 / 0.13) 3px 4px);
	}
	.bvf-cell.void {
		background: none;
		box-shadow: inset 0 0 0 1px var(--line);
		border: 1px dashed var(--line);
		opacity: 0.7;
	}
	.bvf-cell.fresh {
		box-shadow: inset 0 0 0 1.5px var(--fg);
		font-weight: 700;
	}
	.bvf-count {
		margin: 0.45rem 0 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.bvf-matrix {
		display: grid;
		grid-template-columns: 1.4rem repeat(var(--g), 1.5rem);
		grid-auto-rows: 1.5rem;
		gap: 2px;
	}
	.bvf-mh {
		display: grid;
		place-items: center;
		font-family: var(--mono);
		font-size: 0.6rem;
		color: var(--muted);
	}
	.bvf-m {
		display: grid;
		place-items: center;
		border-radius: 3px;
		font-size: 0.7rem;
		color: var(--c-drift);
		background: var(--code-bg);
		transition: background-color 0.35s;
	}
	.bvf-m.on {
		background: color-mix(in srgb, var(--fg) 22%, var(--surface));
	}
	.bvf-m.run {
		background: color-mix(in srgb, var(--c-run) 45%, var(--surface));
	}
	.bvf-m.hot {
		background: color-mix(in srgb, var(--c-drift) 55%, var(--surface));
	}
	.bvf-m.read {
		background: color-mix(in srgb, var(--c-cache) 45%, var(--surface));
	}
	.bvf-m.frozen {
		background: color-mix(in srgb, var(--c-cache) 20%, var(--surface));
	}
	.bvf-m.off {
		background: var(--code-bg);
	}
	.bvf-m.blocked {
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-drift) 50%, transparent);
	}
	.bvf-m.gone {
		background: none;
		border: 1px dashed var(--line);
	}
	.bvf-mcap {
		margin: 0.35rem 0 0;
		font-family: var(--mono);
		font-size: 0.62rem;
		color: var(--muted);
	}
	.bvf-note {
		margin: 0.6rem 0 0;
		min-height: 3em;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--muted);
	}
	.bvf-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 0.9rem 0 0;
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
	}
	.bvf-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		display: inline-grid;
		place-items: center;
		border-radius: 3px;
		font-style: normal;
		font-size: 0.6rem;
	}
	.sw.run {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
	}
	.sw.drift {
		background: color-mix(in srgb, var(--c-drift) 30%, var(--surface));
	}
	.sw.cache {
		background: color-mix(in srgb, var(--c-cache) 22%, var(--surface));
	}
	.sw.write {
		background: color-mix(in srgb, var(--c-run) 30%, var(--surface));
		box-shadow: inset 0 -3px 0 var(--c-cache);
	}
	.sw.mask {
		background: repeating-linear-gradient(-45deg, var(--surface) 0 3px, rgb(0 0 0 / 0.15) 3px 4px);
		border: 1px solid var(--line);
	}
	.sw.void {
		border: 1px dashed var(--faint);
	}
	.sw.hot {
		background: color-mix(in srgb, var(--c-drift) 55%, var(--surface));
	}
	.sw.blocked {
		color: var(--c-drift);
		background: var(--code-bg);
	}
	.bvf-totals {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
		margin-top: 0.8rem;
		padding-top: 0.8rem;
		border-top: 1px dashed var(--line);
	}
	.bvf-totals :global(div) {
		display: grid;
		gap: 0.05rem;
		padding: 0.5rem 0.6rem;
		border-radius: 8px;
		background: var(--code-bg);
	}
	.bvf-totals :global(span) {
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.bvf-totals :global(b) {
		font-family: var(--mono);
		font-size: 1.25rem;
	}
	.bvf-totals :global(small) {
		font-size: 0.78rem;
		color: var(--muted);
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.bvf {
			padding: 1rem;
		}
		.bvf-body {
			grid-template-columns: 1fr;
		}
		.bvf-groups,
		.bvf-strip {
			gap: 1px;
		}
		.bvf-groups span {
			font-size: 0.52rem;
		}
		.bvf-cell {
			font-size: 0;
		}
		.bvf-totals {
			grid-template-columns: 1fr;
		}
	}
</style>
