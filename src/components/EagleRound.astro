---
// One EAGLE round, by position (S02). The target has read positions 1-32 and written x33 itself.
// 1. The drafter (1 layer + the LM head) guesses 34..48 one at a time, each step feeding back its own output.
// 2. One target pass reads 33..48 together.
// 3. Compare left to right: 34-39 agree, 40 does not. 41-48 are thrown away.
// 4. The target's own token at 40 replaces the draft. 7 tokens (34-40) this round.
// 5. Next round: x40 is the anchor; the drafter starts again from the target's real feature at 39.
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
---

<figure class="er" data-er>
	<div class="er-controls">
		<button class="btn primary" type="button" data-act="play">Play</button>
		<button class="btn icon" type="button" data-act="prev" aria-label="Back">‹</button>
		<button class="btn icon" type="button" data-act="next" aria-label="Forward">›</button>
		<span class="er-step" data-stepno></span>
	</div>

	<div class="er-body">
		<div class="er-prefix"><span data-prefix>1–32</span><small>read by the target</small></div>
		<div class="er-main">
			<div class="er-grid" data-pos></div>
			<div class="er-grid" data-cells></div>
			<div class="er-grid er-marks" data-marks></div>
			<div class="er-pass" data-pass></div>
		</div>
	</div>

	<div class="er-count" data-count></div>
	<p class="er-note" data-note aria-live="polite"></p>

	<p class="er-legend" aria-hidden="true">
		<span><i class="sw anc"></i>target's own token</span>
		<span><i class="sw draft"></i>drafter's guess</span>
		<span><i class="sw acc"></i>accepted</span>
		<span><i class="sw bad"></i>rejected</span>
		<span><i class="sw gone"></i>thrown away</span>
	</p>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	const FIRST = 33;
	const N = 16; // positions 33..48
	const BAD = 40; // first rejected position
	const NOTES = [
		'The target has read positions 1–32. That pass gave its top-layer features f₁ … f₃₂ and its own next token x₃₃. Nothing after 33 exists yet, so the target has no features there.',
		'The drafter guesses 34 to 48 one at a time: 1 decoder layer and the LM head per guess. Each step feeds back its own predicted feature and the token it just sampled. 15 small passes, no target pass.',
		'One target pass reads 33 to 48 together. Reading 16 tokens costs about as much as reading one, because at small batch the time goes into loading the weights. At every position it gives its own choice for the next one.',
		'Compare left to right. 34 to 39 agree with the target. 40 does not: stop there. 41 to 48 were guessed after a wrong token, so they are thrown away, right or not.',
		'Keep 34–39 and take the target\'s own token at 40. 7 new tokens from 1 target pass. The same pass gave the real features at 33–39; the cache keeps those and drops 40–48.',
		'Next round: x₄₀ is the new anchor. The drafter restarts from the target\'s real feature at 39 and guesses 41 onward.',
	];
	const LAST = NOTES.length - 1;

	document.querySelectorAll<HTMLElement>('[data-er]').forEach((fig) => {
		const $ = (s: string) => fig.querySelector<HTMLElement>(s)!;
		const posRow = $('[data-pos]');
		const cells = $('[data-cells]');
		const marks = $('[data-marks]');
		const pass = $('[data-pass]');
		const count = $('[data-count]');
		const note = $('[data-note]');
		const stepno = $('[data-stepno]');
		const prefix = $('[data-prefix]');
		const playBtn = $('[data-act="play"]') as HTMLButtonElement;
		let step = 0;
		let timer = 0;

		function render() {
			const next = step === LAST;
			const base = next ? BAD : FIRST; // first position shown in the row
			prefix.textContent = next ? `1–${BAD - 1}` : `1–${FIRST - 1}`;
			const ps = Array.from({ length: N }, (_, i) => base + i);
			posRow.innerHTML = ps.map((p) => `<span class="p">${p}</span>`).join('');

			cells.innerHTML = ps
				.map((p, i) => {
					if (i === 0) return `<span class="c anc">x</span>`;
					if (next || step === 0) return `<span class="c empty"></span>`;
					let cls = 'draft';
					if (step >= 3) cls = p < BAD ? 'acc' : p === BAD ? 'bad' : 'gone';
					if (step >= 4 && p === BAD) cls = 'anc';
					const anim = step === 1 ? ` pop" style="--d:${(i - 1) * 140}ms` : '';
					return `<span class="c ${cls}${anim}">${cls === "anc" ? "x" : "x̂"}</span>`;
				})
				.join('');

			marks.innerHTML = ps
				.map((p, i) => {
					if (step < 3 || next || i === 0) return '<span></span>';
					if (p < BAD) return '<span class="ok">✓</span>';
					if (p === BAD) return '<span class="no">✗</span>';
					return '<span></span>';
				})
				.join('');

			pass.className = 'er-pass' + (step === 2 ? ' on' : '');
			pass.textContent = step === 2 ? 'one target pass: all 32 layers, positions 33–48 at once' : '';

			const drafter = step >= 1 && !next ? 15 : 0;
			const target = step >= 2 && !next ? 1 : 0;
			const got = step >= 4 && !next ? `${BAD - FIRST} new tokens (34–${BAD})` : '';
			count.innerHTML = next
				? '<span>round 2 starts</span>'
				: `<span>drafter passes <b>${drafter}</b></span><span>target passes <b>${target}</b></span>${got ? `<span><b>${got}</b></span>` : ''}`;

			note.textContent = NOTES[step];
			stepno.textContent = `step ${step + 1} / ${NOTES.length}`;
			playBtn.textContent = timer ? 'Pause' : step === LAST ? 'Replay' : 'Play';
		}

		function stop() {
			window.clearInterval(timer);
			timer = 0;
		}
		function go(s: number) {
			step = Math.max(0, Math.min(LAST, s));
			render();
		}
		playBtn.addEventListener('click', () => {
			if (timer) {
				stop();
				render();
				return;
			}
			if (step === LAST) step = 0;
			timer = window.setInterval(() => {
				if (step >= LAST) {
					stop();
					render();
					return;
				}
				go(step + 1);
			}, 3200);
			render();
		});
		$('[data-act="prev"]').addEventListener('click', () => {
			stop();
			go(step - 1);
		});
		$('[data-act="next"]').addEventListener('click', () => {
			stop();
			go(step + 1);
		});
		render();
	});
</script>

<style>
	.er {
		--c-ok: #2f6fb3;
		--c-dr: #b7791f;
		--c-bad: #c2410c;
		--c-bon: #2f7d4f;
		margin: 2rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}
	:global(:root[data-theme='dark']) .er {
		--c-ok: #4f8fd6;
		--c-dr: #e0b04f;
		--c-bad: #e06a2c;
		--c-bon: #4fb07a;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .er {
			--c-ok: #4f8fd6;
			--c-dr: #e0b04f;
			--c-bad: #e06a2c;
			--c-bon: #4fb07a;
		}
	}
	.er-controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.er-step {
		margin-left: auto;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.er-body {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.5rem;
		align-items: start;
		margin-top: 1.1rem;
	}
	.er-prefix {
		display: grid;
		place-items: center;
		align-self: stretch;
		padding: 0.3rem 0.6rem;
		border-radius: 5px;
		background: var(--code-bg);
		border: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 0.75rem;
		text-align: center;
	}
	.er-prefix small {
		font-size: 0.55rem;
		color: var(--muted);
	}
	.er-grid {
		display: grid;
		grid-template-columns: repeat(16, minmax(0, 1fr));
		gap: 3px;
		font-family: var(--mono);
	}
	.er-grid :global(.p) {
		font-size: 0.55rem;
		text-align: center;
		color: var(--muted);
	}
	.er-grid :global(.c) {
		display: grid;
		place-items: center;
		height: 2rem;
		border: 1.5px solid var(--line);
		border-radius: 4px;
		font-size: 0.7rem;
		transition: background 0.3s, border-color 0.3s, opacity 0.3s;
	}
	.er-grid :global(.c.empty) {
		border-style: dashed;
	}
	.er-grid :global(.c.anc),
	.sw.anc {
		background: color-mix(in srgb, var(--c-bon) 18%, var(--surface));
		border-color: var(--c-bon);
		font-weight: 600;
	}
	.er-grid :global(.c.draft),
	.sw.draft {
		background: color-mix(in srgb, var(--c-dr) 14%, var(--surface));
		border: 1.5px dashed var(--c-dr);
	}
	.er-grid :global(.c.acc),
	.sw.acc {
		background: color-mix(in srgb, var(--c-ok) 16%, var(--surface));
		border-color: var(--c-ok);
	}
	.er-grid :global(.c.bad),
	.sw.bad {
		border-color: var(--c-bad);
		color: var(--c-bad);
		text-decoration: line-through;
	}
	.er-grid :global(.c.gone),
	.sw.gone {
		border: 1.5px dashed var(--line);
		opacity: 0.35;
	}
	.er-grid :global(.c.pop) {
		animation: pop 0.35s both;
		animation-delay: var(--d);
	}
	@keyframes pop {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	.er-marks {
		min-height: 1rem;
		font-size: 0.7rem;
		text-align: center;
	}
	.er-marks :global(.ok) {
		color: var(--c-ok);
	}
	.er-marks :global(.no) {
		color: var(--c-bad);
	}
	.er-pass {
		min-height: 1.5rem;
		margin-top: 2px;
		border-radius: 4px;
		font-family: var(--mono);
		font-size: 0.62rem;
		text-align: center;
		line-height: 1.5rem;
		color: transparent;
		transition: background 0.3s, color 0.3s;
	}
	.er-pass.on {
		background: color-mix(in srgb, var(--c-bon) 20%, var(--surface));
		border: 1px solid var(--c-bon);
		color: var(--fg);
	}
	.er-count {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		margin-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--muted);
	}
	.er-count :global(b) {
		color: var(--fg);
		font-weight: 600;
	}
	.er-note {
		min-height: 4.6em;
		margin: 0.9rem 0 0;
		padding: 0.7rem 0.9rem;
		border-left: 3px solid var(--accent);
		background: var(--code-bg);
		border-radius: 0 6px 6px 0;
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.er-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 1rem 0 0;
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--muted);
	}
	.er-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.sw {
		width: 0.9rem;
		height: 0.9rem;
		display: inline-block;
		border: 1.5px solid transparent;
		border-radius: 3px;
	}
	figcaption {
		margin-top: 0.8rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--muted);
	}
	@media (max-width: 640px) {
		.er {
			padding: 1rem;
		}
		.er-body {
			grid-template-columns: 1fr;
		}
		.er-grid {
			gap: 2px;
		}
		.er-grid :global(.c) {
			height: 1.6rem;
			font-size: 0.55rem;
		}
		.er-grid :global(.p) {
			font-size: 0.45rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.er-grid :global(.c.pop) {
			animation: none;
		}
	}
</style>
